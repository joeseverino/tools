#!/usr/bin/env bash
# hq — sync vault frontmatter to Severino HQ, and a few quality-of-life ops.
#
# Every `ssh "$HQ_SSH_HOST" "<remote command>"` call in this file deliberately
# expands $HQ_REMOTE_PATH on the client side — the remote shell needs the
# resolved literal path, not the env var. SC2029 flags this pattern as
# potentially ambiguous; here it's intentional.
# shellcheck disable=SC2029

set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/init.sh" hq "$@"
# shellcheck source=lib/git.sh
source "$TOOLS_HOME/lib/git.sh"

describe_spec() {
    desc_tool "hq" "Sync vault frontmatter to Severino HQ, plus routine HQ operational commands."
    desc_inventory "Integrations" 130
    desc_synopsis "hq <command> [args]"
    desc_effect read
    desc_para "Severino HQ glue. Reads YAML frontmatter from the vault and upserts the HQ docs index. Also wraps the routine ssh + docker compose calls for inspecting the HQ deployment. It does not deploy: landing on main is the deploy."
    # Tool-level examples: declared at global scope (before the first desc_cmd),
    # like global desc_opt/desc_pos — otherwise they'd attach to the last command.
    desc_example "hq sync"                    -- "most common — push vault → HQ"
    desc_example "hq manifest | jq '.[] | .doc_id'"
    desc_example "hq doctor"                  -- "find docs missing frontmatter"
    desc_example "hq export 2026"             -- "download year-summary-2026.md"
    desc_cmd manifest  -- "Print the manifest JSON (frontmatter from every doc) to stdout — for inspection or piping elsewhere"
    desc_effect read

    desc_cmd sync      -- "Sync the docs manifest into HQ; idempotent and safe to re-run"
    desc_effect remote_write +network
    desc_opt --prune     -- "Delete orphan DocumentationRecord rows (doc_ids in HQ but not in the manifest), plus ContentItems linked only to them. Use after a doc_id rename or retirement"
    desc_opt --no-update -- "Only create new records; never update existing ones"

    desc_cmd dev       -- "Run the composed stack locally: the host plus every private plugin checkout found, on one interpreter"
    desc_effect local_write +network
    desc_para "Data-meaning settings (time zone, fiscal year start, review interval) are inherited from the production 1Password env rather than defaulted — a dev/prod time zone difference does not error, it silently reinterprets every timestamp an import writes."
    desc_pos addr +optional -- "Bind address (default \$HQ_DEV_BIND). Binds all interfaces because dev-hq.jseverino.com proxies to this Mac"
    desc_opt --fresh -- "Delete the scratch database first, so the boot starts from empty and re-migrates"
    desc_example "hq dev"                    -- "serve the composed stack on 0.0.0.0:8000"
    desc_example "hq dev --fresh"            -- "start from an empty scratch database"
    desc_example "hq dev 127.0.0.1:8001"     -- "second instance, loopback only"

    desc_cmd doctor    -- "Report vault docs missing or with invalid frontmatter, and whether HQ's last-synced manifest is stale"
    desc_effect read
    desc_opt --env -- "Instead: compare the settings that change what data MEANS (time zone, USE_TZ, reporting windows) between the resolved dev env and production. Exit 1 on a difference. Needs the 1Password CLI; prints these named non-secret settings only"

    desc_cmd schema    -- "Regenerate HQ's docs_index/schema.json from the installed MCP (the canonical frontmatter contract)"
    desc_effect local_write
    desc_opt --check     -- "Verify the HQ schema.json and the vault schema doc match the MCP; exit 1 on drift without writing (CI / pre-deploy gate)"

    desc_cmd validate  -- "Report HQ registry entries (Projects/Assets) that no vault doc references. Read-only"
    desc_effect read +network

    desc_cmd life-sync -- "Emit the Life vault projection on this Mac and install it on HQ (renewals, goals, tasks, claims, vehicles)"
    desc_effect remote_write +network
    desc_para "The Mac is the only machine that can read the vault, so the snapshot originates here. HQ reconciles by doc_id and prunes anything the document omits — so an empty or malformed snapshot is refused locally rather than sent, because sending it would delete the records it failed to mention."
    desc_example "hq life-sync" -- "refresh HQ's Life records from the vault"

    desc_cmd create    -- "Create or update a Project or Asset in HQ (idempotent upsert by slug)"
    desc_effect remote_write +network
    desc_pos kind "{project,asset}" -- "What to create"
    desc_pos slug      -- "Registry slug (the create_project / create_asset key)"
    desc_delegate "HQ's schema-validated project.upsert / asset.upsert MCP capabilities; field names and defaults are owned by HQ"
    desc_example "hq create project my-site --name \"My Site\" --category cloudflare --status published --url https://example.com"
    desc_example "hq create asset example-com --name \"example.com\" --category domain"

    desc_cmd deploy    -- "RETIRED — refuses. It shipped the host-only image and dropped every admitted extension off production. Landing on main IS the deploy"
    desc_effect read
    desc_cmd pin       -- "RETIRED — refuses. It set HQ_COMMIT on every plugin; that variable must not exist, and deleting it is the fix"
    desc_effect read

    desc_cmd ship      -- "Commit + push a small HQ change. The push IS the deploy: it triggers the gated pipeline (build → scan → deploy on green)"
    desc_effect deploy +network
    desc_opt -m --message TEXT -- "Commit message for the HQ repo change (required)"

    desc_cmd env-diff  -- "Key-level drift between the 1Password 'severino-hq env' item (the source of truth) and the env rendered on prod. Key names only — values never print"
    desc_effect read +network

    desc_cmd env-apply -- "Apply 1Password env changes to prod now: runs severino-hq-secrets.service (renders + restarts only if something changed; the hourly timer does this anyway)"
    desc_effect deploy +network

    desc_cmd logs      -- "Show app container logs (default tail 50)"
    desc_effect read +network
    desc_opt -f --follow -- "Stream live output until Ctrl-C"
    desc_opt --tail N    -- "Number of lines to show (default 50; ignored with --follow)"

    desc_cmd restart   -- "\`docker compose restart app\` — no rebuild, no migrations. For stuck state (env changes need env-push: restart does not re-read .env)"
    desc_effect deploy +network

    desc_cmd open      -- "Open \$HQ_URL in the browser"
    desc_effect read

    desc_cmd shell     -- "ssh -t into the HQ Django shell (poke the ORM)"
    desc_effect remote_write +network +interactive

    desc_cmd superuser -- "ssh -t into HQ and run createsuperuser interactively"
    desc_effect remote_write +network +interactive

    desc_cmd export    -- "Download the year summary to ./ and print the path"
    desc_effect local_write +network
    desc_pos year +optional             -- "Year to export (default: current year)"
    desc_pos format +optional "{md,json}" -- "Output format (default: md)"
    desc_env NOTES_HOME    -- "Vault root"
    desc_env HQ_DEV_PLUGINS -- "Plugin checkouts \`hq dev\` composes (<path>=<module:attribute>)"
    desc_env HQ_DEV_PYTHON -- "Interpreter carrying HQ's pinned runtime"
    desc_env HQ_DEV_BIND   -- "Default bind address for \`hq dev\`"
    desc_env HQ_DEV_DB     -- "Scratch SQLite path for \`hq dev\`"
    desc_env HQ_SSH_HOST   -- "SSH alias of the HQ server"
    desc_env HQ_REMOTE_PATH -- "HQ checkout path on the server"
    desc_env HQ_LOCAL_PATH -- "Local HQ checkout"
    desc_env HQ_URL        -- "Public URL of HQ"
    desc_env HQ_MCP_CLIENT_CONFIG -- "Non-secret HQ MCP endpoint/auth-helper profile"
}

require_manifest_mcp() {
    svmc_available \
        || die "error" "severino-vault-mcp is required; run \`site reinstall-mcp\`"
}

build_manifest() {
    require_manifest_mcp
    local help
    help="$(svmc --help 2>&1 || true)"
    if [[ "$help" != *"hq-manifest"* ]]; then
        die "error" "installed severino-vault-mcp is outdated; run \`site reinstall-mcp\`"
    fi
    # Dir list is the MCP's to derive (indexed_dirs + slim content dirs) — the
    # HQ_VAULT_DIRS second hand-kept copy is retired.
    svmc hq-manifest "$VAULT"
}

hq_mcp_call() {
    [[ -x "$HQ_MCP_CLIENT" ]] || die "error" "HQ MCP client is unavailable: $HQ_MCP_CLIENT"
    "$HQ_MCP_CLIENT"
}

require_hq_admin() {
    [[ -n "$HQ_SSH_HOST" ]] || die "error" "HQ_SSH_HOST is required for host administration"
    [[ -n "$HQ_REMOTE_PATH" ]] || die "error" "HQ_REMOTE_PATH is required for host administration"
}

# ----- composed local dev ------------------------------------------------------
#
# Production is one image composing the host with every admitted plugin, so a
# local boot that loads the host alone is not the thing that ships. `hq dev`
# assembles the same composition from the checkouts on this Mac, and takes the
# settings that change what data MEANS from prod's own env rather than from
# whatever the committed defaults happen to be.

HQ_PROD_ENV=""          # KEY=value lines, HQ_SEMANTIC_ENV only — never secrets
HQ_PROD_UNFORWARDED=""  # key names prod sets that read semantic but aren't forwarded

# hq_load_prod_env — resolve production's data-meaning env from 1Password once.
# Reads only the names in HQ_SEMANTIC_ENV; that allowlist is what keeps this
# from being a path to printing DJANGO_SECRET_KEY. It dies rather than falling
# back to the committed defaults on purpose: an unreachable 1Password that
# silently yields America/Chicago is precisely how a bad import gets written and
# reviewed without anyone seeing an error.
hq_load_prod_env() {
    [[ -n "$HQ_PROD_ENV" ]] && return 0
    command -v op >/dev/null 2>&1 \
        || die "error" "1Password CLI (op) is required to resolve production's data-meaning settings"
    local item allow
    item="$(op item get "$HQ_ENV_ITEM" --vault "$HQ_ENV_VAULT" --format json 2>/dev/null)" \
        || die "error" "cannot read \"$HQ_ENV_ITEM\" from 1Password — unlock the app and retry"
    allow="^($(IFS='|'; printf '%s' "${HQ_SEMANTIC_ENV[*]}"))\$"
    HQ_PROD_ENV="$(jq -r --arg allow "$allow" \
        '.fields[] | select((.label // "") | test($allow)) | "\(.label)=\(.value // "")"' \
        <<<"$item")"
    # Key names only — the point is to notice the forward list lagging the item,
    # and a value is never needed to notice that.
    HQ_PROD_UNFORWARDED="$(jq -r --arg allow "$allow" --arg semantic "$HQ_SEMANTIC_PATTERN" \
        '.fields[] | (.label // "")
         | select(test("^[A-Z][A-Z0-9_]+$") and test($semantic) and (test($allow) | not))' \
        <<<"$item")"
    item=""
    grep -q '^DJANGO_TIME_ZONE=.' <<<"$HQ_PROD_ENV" \
        || die "error" "\"$HQ_ENV_ITEM\" has no DJANGO_TIME_ZONE value to inherit"
}

hq_prod_value() {
    local line
    line="$(grep -m1 "^$1=" <<<"$HQ_PROD_ENV" || true)"
    printf '%s' "${line#*=}"
}

HQ_DEV_PYTHONPATH=""
HQ_DEV_REFS=""

# hq_resolve_dev_plugins — the host plus whichever plugin checkouts are on this
# machine. A missing sibling is skipped rather than fatal: the composition is
# the point, but a partial one still beats hand-assembling PYTHONPATH.
hq_resolve_dev_plugins() {
    [[ -n "$HQ_DEV_PYTHONPATH" ]] && return 0
    local entry dir ref
    local -a paths=("$HQ_LOCAL_PATH") refs=()
    for entry in ${HQ_DEV_PLUGINS[@]+"${HQ_DEV_PLUGINS[@]}"}; do
        dir="${entry%%=*}"
        ref="${entry#*=}"
        if [[ ! -d "$dir/src" ]]; then
            msg "$DIM" "skip" "no checkout at $dir" >&2
            continue
        fi
        paths+=("$dir/src")
        refs+=("$ref")
    done
    HQ_DEV_PYTHONPATH="$(IFS=:; printf '%s' "${paths[*]}")"
    HQ_DEV_REFS="$(IFS=,; printf '%s' "${refs[*]:-}")"
}

# hq_dev_env — the complete environment the composed dev stack runs under, as
# `KEY=value` arguments for `env -i`. Complete, not additive: the operator's
# shell is excluded so a stale `export DJANGO_TIME_ZONE` cannot reinterpret the
# data underneath the server, and so this list is the whole truth about what the
# dev stack sees. DJANGO_DEBUG is required — plugin admission fails closed
# without a Cordon lock, which only the production image carries.
hq_dev_env() {
    hq_resolve_dev_plugins
    hq_load_prod_env
    printf '%s\n' \
        "PATH=$PATH" \
        "HOME=$HOME" \
        "USER=${USER-}" \
        "TERM=${TERM-}" \
        "LANG=${LANG-}" \
        "TMPDIR=${TMPDIR-}" \
        "DJANGO_SETTINGS_MODULE=config.settings" \
        "DJANGO_DEBUG=true" \
        "PYTHONPATH=$HQ_DEV_PYTHONPATH" \
        "SEVERINO_HQ_PLUGINS=$HQ_DEV_REFS" \
        "DJANGO_ALLOWED_HOSTS=$HQ_DEV_HOSTS" \
        "DJANGO_CSRF_TRUSTED_ORIGINS=$HQ_DEV_ORIGINS" \
        "SEVERINO_DATABASE_PATH=$HQ_DEV_DB"
    printf '%s\n' "$HQ_PROD_ENV"
}

# hq_effective_settings <KEY=VALUE>... — what HQ's settings actually resolve to
# under the given environment. Resolved through the real config.settings, so a
# committed default counts as a value and a setting that is not yet
# environment-driven (USE_TZ) is still compared. Plugins stay off: what a
# setting means belongs to the host, and loading them would drag in admission.
hq_effective_settings() {
    env -i \
        PATH="$PATH" \
        HOME="$HOME" \
        DJANGO_SETTINGS_MODULE=config.settings \
        DJANGO_DEBUG=true \
        SEVERINO_HQ_PLUGINS= \
        PYTHONPATH="$HQ_LOCAL_PATH" \
        SEVERINO_APP_ENV_PATH=/nonexistent \
        "$@" \
        "$HQ_DEV_PYTHON" -c '
import sys
from django.conf import settings

for name in sys.argv[1:]:
    print("%s=%s" % (name, getattr(settings, name, "(unset)")))
' "${HQ_SEMANTIC_SETTINGS[@]}"
}

require_dev_runtime() {
    [[ -f "$HQ_LOCAL_PATH/manage.py" ]] \
        || die "error" "no HQ checkout at $HQ_LOCAL_PATH"
    [[ -x "$HQ_DEV_PYTHON" ]] \
        || die "error" "no interpreter with HQ's runtime at $HQ_DEV_PYTHON"
}

cmd_dev() {
    local bind="$HQ_DEV_BIND" fresh=0
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --fresh) fresh=1; shift ;;
            -*)      die_unknown flag "$1" dev ;;
            *)       bind="$1"; shift ;;
        esac
    done

    require_dev_runtime
    hq_resolve_dev_plugins
    hq_load_prod_env

    # Both resolutions above are cached and already succeeded, so nothing here
    # can die inside the substitution and leave a half-built environment.
    local -a dev_env=()
    local line
    while IFS= read -r line; do dev_env+=("$line"); done < <(hq_dev_env)

    mkdir -p "$(dirname "$HQ_DEV_DB")"
    if (( fresh )); then
        rm -f "$HQ_DEV_DB"
        msg "$DIM" "fresh" "recreated the scratch database"
    fi

    # Migrate then serve, the same order the production entrypoint uses: cheap
    # when there is nothing to apply, and it retires "pulled a plugin migration
    # and forgot" as a category.
    env -i "${dev_env[@]}" "$HQ_DEV_PYTHON" "$HQ_LOCAL_PATH/manage.py" migrate --noinput

    msg "$GREEN" "plugins"  "${HQ_DEV_REFS:-none found — host only}"
    msg "$GREEN" "timezone" "$(hq_prod_value DJANGO_TIME_ZONE) (inherited from \"$HQ_ENV_ITEM\")"
    msg "$DIM"   "database" "$HQ_DEV_DB"
    msg "$DIM"   "serving"  "$bind"
    exec env -i "${dev_env[@]}" \
        "$HQ_DEV_PYTHON" "$HQ_LOCAL_PATH/manage.py" runserver "$bind"
}

cmd_manifest() {
    build_manifest
}

cmd_schema() {
    local check=0
    case "${1:-}" in
        --check) check=1 ;;
        "") : ;;
        *) die_unknown flag "$1" schema ;;
    esac

    require_manifest_mcp
    if ! svmc schema --json >/dev/null 2>&1; then
        die "error" "installed severino-vault-mcp lacks \`schema\`; run \`site reinstall-mcp\`"
    fi

    local dest="$HQ_LOCAL_PATH/docs_index/schema.json"
    [[ -d "$HQ_LOCAL_PATH/docs_index" ]] \
        || die "error" "HQ docs_index not found at $HQ_LOCAL_PATH/docs_index"

    if [[ "$check" == "1" ]]; then
        local failed=0
        if diff -q <(svmc schema --json) "$dest" >/dev/null 2>&1; then
            msg "$GREEN" "ok" "docs_index/schema.json matches the MCP"
        else
            msg "$RED" "drift" "docs_index/schema.json is stale — run \`hq schema\`"
            failed=1
        fi

        local doc_out
        if [[ ! -f "$HQ_SCHEMA_DOC" ]]; then
            msg "$YELLOW" "skip" "vault schema doc not found: $HQ_SCHEMA_DOC"
        elif doc_out="$(svmc schema --check-doc "$HQ_SCHEMA_DOC" 2>&1)"; then
            msg "$GREEN" "ok" "vault Frontmatter Schema doc matches the MCP"
        else
            msg "$RED" "drift" "vault Frontmatter Schema doc lists stale enum values:"
            printf '%s\n' "$doc_out" | sed 's/^/  /'
            failed=1
        fi

        [[ "$failed" == "0" ]] || die "error" "schema drift — fix the above" 1
    else
        svmc schema --json > "$dest"
        msg "$GREEN" "wrote" "docs_index/schema.json (from the MCP)"

        local doc_out
        if [[ -f "$HQ_SCHEMA_DOC" ]] \
            && ! doc_out="$(svmc schema --check-doc "$HQ_SCHEMA_DOC" 2>&1)"; then
            msg "$YELLOW" "warn" "vault Frontmatter Schema doc lists stale enum values:"
            printf '%s\n' "$doc_out" | sed 's/^/  /'
            msg "$DIM" "fix" "update the enum lines in $HQ_SCHEMA_DOC by hand"
        fi
        msg "$DIM" "next" "commit schema.json + deploy HQ so the contract ships"
    fi
}

# Non-fatal preflight: warn if HQ's committed schema.json lags the installed
# MCP. A stale contract means the deployed importer can reject docs the MCP
# considers valid. Best-effort — silent if the MCP or the file is absent.
schema_drift_warn() {
    svmc_available || return 0
    svmc schema --json >/dev/null 2>&1 || return 0
    local dest="$HQ_LOCAL_PATH/docs_index/schema.json"
    [[ -f "$dest" ]] || return 0
    if ! diff -q <(svmc schema --json) "$dest" >/dev/null 2>&1; then
        msg "$YELLOW" "schema" \
            "HQ docs_index/schema.json lags the MCP — run \`hq schema\`, commit, deploy"
    fi
}

cmd_sync() {
    local prune="0"
    local update="1"
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --prune) prune="1"; shift ;;
            --no-update) update="0"; shift ;;
            *) die_unknown flag "$1" sync ;;
        esac
    done

    schema_drift_warn

    local tmp
    tmp="$(mktemp -t hq-manifest.XXXXXX.json)"
    trap 'rm -f "${tmp:-}"' EXIT

    build_manifest > "$tmp"

    msg "$DIM" "sync" "vault → HQ"
    local result_json stats_json
    result_json="$(
        jq -cn \
            --slurpfile manifest "$tmp" \
            --argjson update "$update" \
            --argjson prune "$prune" \
            '{tool:"execute_capability",arguments:{name:"hq.sync",payload:{manifest:$manifest[0],update_existing:$update,report_orphans:true,prune_orphans:$prune,confirm_prune:$prune}}}' \
            | hq_mcp_call
    )"
    if [[ "$(jq -r '.ok' <<<"$result_json")" != "true" ]]; then
        die "error" "$(jq -r '.error.message // "HQ sync failed"' <<<"$result_json")"
    fi
    stats_json="$(jq -c '.documentation.stats' <<<"$result_json")"

    python3 - "$tmp" "$stats_json" "$prune" <<'PY'
import json
import sys

manifest_path, raw_stats, prune_flag = sys.argv[1:4]
manifest = json.load(open(manifest_path, encoding="utf-8"))
stats = json.loads(raw_stats)
prune = prune_flag == "1"

created = stats.get("created", 0)
updated = stats.get("updated", 0)
doc_pruned = stats.get("orphans_pruned", 0)
content_synced = stats.get("content_items_synced", 0)
content_pruned = stats.get("content_items_pruned", 0)
missing = stats.get("missing_relations", 0)
orphans = stats.get("orphans") or []

print(f"Docs      {len(manifest)} indexed")

changes = []
if created:
    changes.append(f"{created} created")
if updated:
    changes.append(f"{updated} updated")
if doc_pruned:
    changes.append(f"{doc_pruned} removed")
print(f"Changes   {', '.join(changes) if changes else 'none'}")

if missing:
    print(f"Relations {missing} missing")
    for item in stats.get("missing_relations_detail", [])[:8]:
        print(f"          {item['doc_id']} → missing {item['kind']} {item['slug']}")
else:
    print("Relations ok")

content = []
if content_synced:
    content.append(f"{content_synced} mirrored")
if content_pruned:
    content.append(f"{content_pruned} stale removed")
print(f"Content   {', '.join(content) if content else 'none'}")

if orphans:
    if prune:
        print(f"Cleanup   pruned {len(orphans)} orphan doc row(s)")
    else:
        print(f"Cleanup   {len(orphans)} orphan doc row(s); run `hq sync --prune`")
        for doc_id in orphans[:8]:
            print(f"          {doc_id}")
else:
    print("Cleanup   no orphans")

if missing or (orphans and not prune):
    print("Done      synced with cleanup needed")
else:
    print("Done      HQ is in sync")
PY

    # Record what shipped — manifest hash plus the exact inputs — so
    # `vault status` and `hq doctor` can detect staleness deterministically
    # (see hq_sync_freshness in lib/common.sh).
    local state_file vault_head
    state_file="$(hq_sync_state_file)"
    mkdir -p "$(dirname "$state_file")"
    vault_head="$(git -C "$VAULT" rev-parse HEAD 2>/dev/null || echo unknown)"
    python3 -c '
import hashlib, json, sys
from datetime import datetime, timezone

manifest, state, vault, dirs, head = sys.argv[1:6]
with open(manifest, "rb") as fh:
    sha = hashlib.sha256(fh.read()).hexdigest()
with open(state, "w", encoding="utf-8") as fh:
    json.dump(
        {
            "manifest_sha256": sha,
            "vault": vault,
            "vault_dirs": dirs,
            "vault_head": head,
            "synced_at": datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"),
        },
        fh,
        indent=2,
    )
    fh.write("\n")
' "$tmp" "$state_file" "$VAULT" "mcp-default" "$vault_head"
}

# Dev/prod parity for the settings that change what stored data MEANS. A
# difference here produces no error and no failed request — it reinterprets
# every timestamp and reporting window under a boot that otherwise looks fine,
# which is why this is a gate and not a note in a README.
#
# Both sides are resolved through the real config.settings, and the dev side is
# read back out of the environment `hq dev` builds rather than assumed, so this
# also fails when `hq dev` stops forwarding something it used to.
cmd_doctor_env() {
    require_dev_runtime
    hq_load_prod_env

    local semantic
    semantic="^($(IFS='|'; printf '%s' "${HQ_SEMANTIC_ENV[*]}"))="

    local -a dev_semantic=() prod_semantic=()
    local line
    while IFS= read -r line; do dev_semantic+=("$line"); done \
        < <(hq_dev_env | grep -E "$semantic")
    while IFS= read -r line; do prod_semantic+=("$line"); done \
        < <(printf '%s\n' "$HQ_PROD_ENV")

    # Either side can legitimately be empty — that is what "dev forwards
    # nothing" looks like — so both expansions tolerate an unset array rather
    # than aborting before the comparison that would have reported it.
    local dev prod
    dev="$(hq_effective_settings ${dev_semantic[@]+"${dev_semantic[@]}"})"
    prod="$(hq_effective_settings ${prod_semantic[@]+"${prod_semantic[@]}"})"

    python3 - "$dev" "$prod" "$HQ_PROD_UNFORWARDED" <<'PY'
import sys

dev_raw, prod_raw, unforwarded = sys.argv[1:4]


def parse(raw):
    return dict(
        line.split("=", 1) for line in raw.splitlines() if "=" in line
    )


dev, prod = parse(dev_raw), parse(prod_raw)
rows = [
    (name, dev.get(name, "(unset)"), prod.get(name, "(unset)"))
    for name in sorted(set(dev) | set(prod))
]
widths = [
    max(len(str(cell)) for cell in column)
    for column in zip(("setting", "dev", "prod"), *rows)
]
mismatched = [row for row in rows if row[1] != row[2]]

print()
print("  %-*s  %-*s  %-*s  %s" % (widths[0], "setting", widths[1], "dev",
                                  widths[2], "prod", "verdict"))
for name, dev_value, prod_value in rows:
    print("  %-*s  %-*s  %-*s  %s" % (
        widths[0], name, widths[1], dev_value, widths[2], prod_value,
        "ok" if dev_value == prod_value else "MISMATCH",
    ))
print()

missing = [key for key in unforwarded.splitlines() if key]
for key in missing:
    print("  prod sets %s, which reads as data-meaning and dev does not "
          "inherit" % key)
    print("  fix       add it to HQ_SEMANTIC_ENV in config/hq.sh")
if missing:
    print()

if mismatched or missing:
    print("  dev and prod disagree about what the data means")
    sys.exit(1)
print("  dev matches prod on every data-meaning setting")
PY
}

cmd_doctor() {
    case "${1:-}" in
        --env) shift; cmd_doctor_env "$@"; return ;;
        "")    : ;;
        *)     die_unknown flag "$1" doctor ;;
    esac

    # The "what counts as a valid indexed doc" contract (skip rules, slim
    # writeup/page tolerance) lives once, in the MCP's manifest generator. Ask
    # it for the structured report instead of re-walking the vault here.
    require_manifest_mcp
    local report
    report="$(svmc hq-manifest "$VAULT" --report 2>/dev/null)" \
        || true
    [[ -n "$report" ]] \
        || die "error" "hq-manifest --report returned nothing; run \`site reinstall-mcp\`"

    local rc=0
    printf '%s' "$report" | python3 -c '
import json, sys

r = json.load(sys.stdin)
missing = r.get("missing_frontmatter", [])
dups = r.get("duplicates", [])

if not missing and not dups:
    print("ok: %s indexed docs have valid frontmatter" % r.get("count", 0))
    sys.exit(0)

if dups:
    print("%d duplicate doc_id(s):" % len(dups))
    for d in dups:
        print("  - %s: %s  <->  %s" % (d["doc_id"], d["first"], d["second"]))
if missing:
    print("%d doc(s) missing or invalid frontmatter:" % len(missing))
    for path in missing:
        print("  - " + path)
sys.exit(1)
' || rc=1

    # The other half of "the gap between vault state and HQ state": is the
    # manifest HQ holds the one the vault produces right now?
    local fresh
    fresh="$(hq_sync_freshness "$VAULT")"
    case "$fresh" in
        never)  msg "$YELLOW" "sync" "no recorded hq sync yet — run \`hq sync\`" ;;
        skip)   ;;
        fresh*) msg "$GREEN"  "sync" "HQ matches the vault manifest (last sync ${fresh#fresh })" ;;
        stale*) msg "$YELLOW" "sync" "doc metadata changed since the last sync (${fresh#stale }) — run \`hq sync\`"
                rc=1 ;;
    esac
    return "$rc"
}

cmd_validate() {
    msg "$DIM" "validate" "HQ registry ↔ vault docs"
    jq -cn '{tool:"audit_registry",arguments:{}}' | hq_mcp_call | python3 -c '
import json, sys
r = json.load(sys.stdin)
projects = r["orphan_projects"]
assets = r["orphan_assets"]
print("Projects  {} total, {} with zero docs".format(r["projects_total"], len(projects)))
for slug in projects:
    print(f"          orphan: {slug}")
print("Assets    {} total, {} with zero docs".format(r["assets_total"], len(assets)))
for slug in assets:
    print(f"          orphan: {slug}")
print("Registry  " + (
    "review orphans above — stale slug from a rename, or a duplicate row"
    if projects or assets else
    "ok — every Project and Asset is referenced by at least one doc"
))
'
}

cmd_create() {
    local kind="${1:-}"
    case "$kind" in
        project|asset) shift ;;
        # `hq create` (no kind) shows the spec-derived help; `hq create -h` is
        # handled centrally; `hq create <kind> -h` falls through to manage.py.
        "")      usage_command create; return 0 ;;
        *) die_unknown kind "$kind" create ;;
    esac

    if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
        jq -cn '{tool:"describe_capabilities",arguments:{}}' | hq_mcp_call \
            | python3 -c '
import json, sys
kind = sys.argv[1]
catalog = json.load(sys.stdin)
name = kind + ".upsert"
capability = next((item for item in catalog["capabilities"] if item["name"] == name), None)
if capability is None:
    raise SystemExit("HQ does not advertise " + name)
schema = capability["input_schema"]
required = set(schema.get("required", []))
print("Usage: hq create {} <slug> [--field value ...]".format(kind))
print("\n" + capability["summary"] + "\n\nFields:")
for field, spec in schema.get("properties", {}).items():
    if field == "slug":
        continue
    label = "--" + field.replace("_", "-")
    detail = []
    if field in required:
        detail.append("required")
    if "default" in spec:
        detail.append("default: {!r}".format(spec["default"]))
    if spec.get("enum"):
        detail.append("one of: " + ", ".join(map(str, spec["enum"])))
    elif spec.get("format"):
        detail.append(spec["format"])
    elif spec.get("type"):
        detail.append(spec["type"])
    print("  {:28} {}".format(label, "; ".join(detail)))
' "$kind"
        return
    fi

    [ "$#" -ge 1 ] || die "missing <slug>; try \`hq create $kind -h\`"

    local slug="$1" result
    msg "$DIM" "hq" "$kind.upsert $slug"
    result="$(python3 "$TOOLS_HOME/lib/hq-create-request.py" "$kind" "$@" | hq_mcp_call)"
    if [[ "$(jq -r '.ok' <<<"$result")" != "true" ]]; then
        die "error" "$(jq -r '.error.message // "HQ operation failed"' <<<"$result")"
    fi
    local created
    created="$(jq -r '.created' <<<"$result")"
    msg "$GREEN" "$kind" "$slug: $([[ "$created" == "true" ]] && printf created || printf updated)"
}

# cmd_life_sync — emit the Life vault projection here, install it on prod.
#
# The Mac is the only machine that can read the vault, so the snapshot has to
# originate here. HQ's ingest reconciles by doc_id and PRUNES whatever the
# document omits, which is the reason for the validation below: a half-built
# index or an emitter that failed partway produces a structurally valid but
# short snapshot, and shipping that deletes every record it forgot to mention.
# Cheaper to refuse here than to restore there.
cmd_life_sync() {
    require_hq_admin
    command -v life >/dev/null 2>&1 \
        || die "error" "the 'life' CLI is required to emit the snapshot"

    local snapshot counts
    msg "$DIM" "emitting" "life snapshot"
    snapshot="$(life snapshot --json)" \
        || die "error" "life snapshot failed; nothing was sent"

    jq -e 'has("schema_version") and has("content_hash") and (.data | type == "object")' \
        >/dev/null 2>&1 <<<"$snapshot" \
        || die "error" "life snapshot is not a valid envelope; nothing was sent"

    # Refuse a snapshot with no records at all. Every collection empty is
    # indistinguishable from "the vault is gone" and would prune everything.
    [[ "$(jq '[.data[] | length] | add // 0' <<<"$snapshot")" -gt 0 ]] \
        || die "error" "life snapshot contains no records; refusing to prune prod"

    counts="$(jq -r '.data | to_entries | map("\(.value | length) \(.key)") | join(" · ")' \
        <<<"$snapshot")"
    msg "$DIM" "sending" "$counts"

    # -T because stdin is a pipe, not a terminal: `docker compose exec` without
    # it allocates a TTY and the document never reaches the command.
    printf '%s' "$snapshot" | ssh "$HQ_SSH_HOST" \
        "cd '$HQ_REMOTE_PATH' && sudo docker compose exec -T app python manage.py ingest_life_snapshot" \
        || die "error" "ingest failed on $HQ_SSH_HOST"
    msg "$GREEN" "synced" "life → severino-hq"
}

# hq deploy — retired. It predates composition.
#
# It resolved the last green ci.yml run and deployed severino-hq:sha-..., the
# HOST-ONLY image, while production runs severino-hq/composition:... -- the host
# plus every admitted extension. Running it took the extensions off production
# and whole domains stopped existing, which is the failure composition was
# introduced to end. It refuses rather than staying available to muscle memory.
cmd_deploy() {
    die "error" "hq deploy is retired: it ships the host-only image and drops every admitted extension off production. Landing on main IS the deploy; to rebuild by hand run the 'Compose and deploy extensions' workflow (workflow_dispatch)."
}

# env-diff / env-apply — prod's env renders from the 1Password "severino-hq
# env" item via severino-hq-secrets.service on the server (see the HQ repo's
# scripts/refresh-secrets.sh). Drift reporting is key-level only: values never
# reach stdout. Value refresh is the hourly timer's job; env-apply just runs
# the same unit on demand.
# hq pin — retired. It created the trap it existed to manage.
#
# It set HQ_COMMIT on every dev plugin, pinning the host source their test jobs
# check out. A pin only ever goes stale, and every failure it causes reads as a
# host bug. Unset, hq-ref falls back to main and a plugin tests against the host
# as it actually is, which is the property the design depends on. Deleting the
# variable is the fix, never moving it.
cmd_pin() {
    die "error" "hq pin is retired: HQ_COMMIT must not exist. Unset, hq-ref falls back to main and each plugin tests against the host as it is. If a plugin's CI fails on something the host plainly has, delete the pin: gh variable delete HQ_COMMIT"
}

cmd_env_diff() {
    require_hq_admin
    case "${1:-}" in "") ;; *) die_unknown flag "$1" env-diff ;; esac
    command -v op >/dev/null 2>&1 || die "error" "1Password CLI (op) is required for env-diff"
    local HQ_ENV_RENDERED="$HQ_REMOTE_PATH/secrets/severino_hq_env"
    # Both sides are read into variables first, and each is required to be
    # non-empty. Comparing two process substitutions inline meant an unreachable
    # 1Password and a refused SSH key produced two empty key lists, which differ
    # in no way -- so the check printed "in sync" and exited 0 having read
    # nothing at all. A parity check that goes green when it cannot see either
    # side is worse than no check, because it is trusted.
    # Each read is captured with its own error text and checked before use. The
    # first version let `set -e` abort on the failed substitution, so the command
    # exited non-zero with no output at all -- fail-closed, but silent, which
    # tells the operator nothing about which half is unreachable.
    local item_json rendered_raw item_keys rendered_keys drift
    if ! item_json="$(op item get "$HQ_ENV_ITEM" --vault "$HQ_ENV_VAULT" --format json 2>&1)"; then
        die "error" "cannot read \"$HQ_ENV_ITEM\" from 1Password: ${item_json##*$'\n'}"
    fi
    item_keys="$(jq -r '.fields[] | select((.label // "") | test("^[A-Z][A-Z0-9_]+$")) | .label' <<<"$item_json" | sort)"
    [[ -n "$item_keys" ]] \
        || die "error" "\"$HQ_ENV_ITEM\" yielded no environment keys — wrong item?"

    # BatchMode so a refused agent key fails immediately instead of blocking on
    # a password prompt no one is watching: a check that hangs is a check that
    # gets skipped.
    if ! rendered_raw="$(ssh -o BatchMode=yes -o ConnectTimeout=10 "$HQ_SSH_HOST" \
        "sudo cat '$HQ_ENV_RENDERED'" 2>&1)"; then
        die "error" "cannot read $HQ_SSH_HOST:$HQ_ENV_RENDERED: ${rendered_raw##*$'\n'}"
    fi
    rendered_keys="$(cut -d= -f1 <<<"$rendered_raw" | sort)"
    [[ -n "$rendered_keys" ]] \
        || die "error" "$HQ_ENV_RENDERED is empty on $HQ_SSH_HOST — has the env been rendered?"
    drift="$(
        awk '
            NR==FNR { l[$0] = 1; next }
            { r[$0] = 1 }
            END {
                for (k in l) if (!(k in r)) print "item-only (not yet rendered): " k
                for (k in r) if (!(k in l)) print "rendered-only (gone from item): " k
            }' \
            <(printf '%s\n' "$item_keys") <(printf '%s\n' "$rendered_keys") | sort
    )"
    if [[ -z "$drift" ]]; then
        msg "$GREEN" "in sync" "item keys match the rendered env on $HQ_SSH_HOST (values refresh hourly)"
        return 0
    fi
    local line
    while IFS= read -r line; do msg "$YELLOW" "drift" "$line"; done <<< "$drift"
    msg "$DIM" "next" "hq env-apply renders the item to prod now"
    return 1
}

cmd_env_apply() {
    require_hq_admin
    case "${1:-}" in ""|--yes) ;; *) die_unknown flag "$1" env-apply ;; esac
    msg "$DIM" "applying" "severino-hq-secrets.service on $HQ_SSH_HOST"
    ssh "$HQ_SSH_HOST" "sudo systemctl start severino-hq-secrets.service && sudo systemctl status severino-hq-secrets.service --no-pager | tail -3"
    local health
    health="$(ssh "$HQ_SSH_HOST" "sudo docker inspect --format '{{.State.Health.Status}}' severino-hq" 2>/dev/null || true)"
    [[ "$health" == "healthy" ]] || die "error" "container is '${health:-unknown}' after env apply — check \`hq logs\`"
    msg "$GREEN" "applied" "prod env is current; container healthy"
}

cmd_ship() {
    local message=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -m|--message) message="${2:?--message needs text}"; shift 2 ;;
            --message=*) message="${1#--message=}"; shift ;;
            *) die_unknown flag "$1" ship ;;
        esac
    done

    [[ -n "$message" ]] || die "usage" "missing -m \"commit message\""
    [[ -d "$HQ_LOCAL_PATH/.git" ]] || die "error" "HQ_LOCAL_PATH is not a git repo: $HQ_LOCAL_PATH"

    msg "$DIM" "checking" "$HQ_LOCAL_PATH (py_compile)"
    (
        cd "$HQ_LOCAL_PATH"
        git ls-files '*.py' | xargs python3 -m py_compile
    )

    if [[ -z "$(git -C "$HQ_LOCAL_PATH" status --porcelain)" ]]; then
        msg "$GREEN" "clean" "no local HQ changes to commit"
        return 0
    fi

    msg "$DIM" "staging" "tracked changes + known HQ app files"

    # Rides lib/git.sh for the commit/push mechanics; the staging policy stays
    # HQ's own: `git add -u` captures tracked edits repo-wide, then git_commit
    # additively stages new files only under the known app dirs (its `git add --
    # <paths>` is additive, so the index is the union of both). git_commit
    # returns 1 when nothing is committable, mapped to exit 7 below. The push IS
    # the deploy — it triggers the gated pipeline.
    local rc=0
    (
        cd "$HQ_LOCAL_PATH"
        git add -u
        local d app_dirs=(assets content core docs docs_index expenses projects
            receipts reports static templates) existing=()
        for d in "${app_dirs[@]}"; do [[ -e "$d" ]] && existing+=("$d"); done
        git_commit "$message" "${existing[@]}" || exit 7
        git_push_current
    ) || rc=$?

    case "$rc" in
        0)
            msg "$GREEN" "pushed" "the pipeline will build -> scan -> deploy on green"
            msg "$DIM"   "watch"  "gh run watch   (or the Actions tab)"
            ;;
        7)
            msg "$YELLOW" "skipped" "no committable HQ changes staged"
            return 0
            ;;
        *)
            die "error" "hq ship failed during commit/push (rc=$rc)" 1
            ;;
    esac

    if [[ -n "$(git -C "$VAULT" status --porcelain 2>/dev/null || true)" ]]; then
        msg "$YELLOW" "vault" "has uncommitted changes; run vault status/sync when ready"
    fi
}

cmd_logs() {
    require_hq_admin
    local tail="50"
    local follow=""
    while [ "$#" -gt 0 ]; do
        case "$1" in
            -f|--follow) follow="-f"; shift ;;
            --tail) tail="${2:?--tail needs a number}"; shift 2 ;;
            --tail=*) tail="${1#--tail=}"; shift ;;
            *) die_unknown flag "$1" logs ;;
        esac
    done

    if [ -n "$follow" ]; then
        ssh -t "$HQ_SSH_HOST" "cd '$HQ_REMOTE_PATH' && sudo docker compose logs app -f"
    else
        ssh "$HQ_SSH_HOST" "cd '$HQ_REMOTE_PATH' && sudo docker compose logs app --tail $tail"
    fi
}

cmd_restart() {
    require_hq_admin
    msg "$DIM" "restarting" "severino-hq"
    ssh "$HQ_SSH_HOST" "cd '$HQ_REMOTE_PATH' && sudo docker compose restart app"
    msg "$GREEN" "restarted" "severino-hq"
}

cmd_open() {
    if command -v open >/dev/null 2>&1; then
        open "$HQ_URL"
    else
        msg "$DIM" "open" "$HQ_URL"
    fi
}

cmd_shell() {
    require_hq_admin
    ssh -t "$HQ_SSH_HOST" "cd '$HQ_REMOTE_PATH' && sudo docker compose exec app python manage.py shell"
}

cmd_superuser() {
    require_hq_admin
    ssh -t "$HQ_SSH_HOST" "cd '$HQ_REMOTE_PATH' && sudo docker compose exec app python manage.py createsuperuser"
}

cmd_export() {
    local year="${1:-$(date +%Y)}"
    local fmt="${2:-md}"
    case "$fmt" in
        md|markdown) ext="md" ;;
        json) ext="json" ;;
        *) die_unknown format "$fmt" export ;;
    esac
    local result out
    result="$(jq -cn --argjson year "$year" --arg format "$ext" \
        '{tool:"export_year_summary",arguments:{year:$year,format:$format}}' \
        | hq_mcp_call)"
    [[ "$(jq -r '.ok' <<<"$result")" == "true" ]] \
        || die "error" "$(jq -r '.error.message // "report export failed"' <<<"$result")"
    out="$(jq -r '.filename' <<<"$result")"
    jq -r '.content' <<<"$result" > "$out"
    msg "$GREEN" "wrote" "$out"
    printf '%s\n' "$out"
}

# All help + the machine surface (main `-h`, `--describe`, focused `<cmd> -h`)
# render from the one spec via the shared intercept; below is just command →
# action. Routine domain operations use MCP; SSH commands below are explicitly
# host-administration surfaces.
desc_help_intercept "$@"
case "${1:-}" in
    manifest)   shift; cmd_manifest "$@" ;;
    sync)       shift; cmd_sync "$@" ;;
    dev)        shift; cmd_dev "$@" ;;
    pin)        shift; cmd_pin "$@" ;;
    doctor)     shift; cmd_doctor "$@" ;;
    schema)     shift; cmd_schema "$@" ;;
    validate)   shift; cmd_validate "$@" ;;
    life-sync)  shift; cmd_life_sync "$@" ;;
    create)     shift; cmd_create "$@" ;;
    deploy)     shift; cmd_deploy "$@" ;;
    env-apply)  shift; cmd_env_apply "$@" ;;
    env-diff)   shift; cmd_env_diff "$@" ;;
    ship)       shift; cmd_ship "$@" ;;
    logs)       shift; cmd_logs "$@" ;;
    restart)    shift; cmd_restart "$@" ;;
    open)       shift; cmd_open "$@" ;;
    shell)      shift; cmd_shell "$@" ;;
    superuser)  shift; cmd_superuser "$@" ;;
    export)     shift; cmd_export "$@" ;;
    *) die_unknown command "$1" ;;
esac
