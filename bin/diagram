#!/usr/bin/env bash
# diagram [path...] — render Mermaid sources to committed PNGs
set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/init.sh" "" "$@"

describe_spec() {
    desc_tool "diagram" "Render Mermaid .mmd sources to neighboring PNG files."
    desc_inventory "Authoring" 180
    desc_effect local_write
    desc_synopsis "diagram <path>..."
    desc_para "Each path may be an .mmd file or a directory. Directories render their top-level .mmd files."
    desc_para "Rendering uses the Mermaid CLI pinned in package.json and the local Chromium, with Joe Severino brand tokens, PNG output up to 3300px on the long side, and a white background. Set DIAGRAM_BRAND_KIT to override the kit directory."
    desc_para "Author flow diagrams with flowchart TB. Contract diagrams may use HTML labels for dense multiline nodes; site diagrams stay on SVG labels when their nodes are single-line."
    desc_pos path +variadic -- "Mermaid source file or directory"
    desc_example "diagram docs/diagrams/"
    desc_example "diagram docs/diagrams/architecture.mmd"
}

desc_help_intercept "$@"
[[ $# -ge 1 ]] || { usage; exit 0; }   # bare invocation: show the main screen

sources=()
for target in "$@"; do
    if [[ -d "$target" ]]; then
        found=0
        for src in "$target"/*.mmd; do
            [[ -f "$src" ]] || continue
            sources+=("$src")
            found=1
        done
        (( found )) || die "error" "no .mmd files found in: $target"
    elif [[ -f "$target" && "$target" == *.mmd ]]; then
        sources+=("$target")
    elif [[ -e "$target" ]]; then
        die "error" "expected an .mmd file or directory: $target"
    else
        die "error" "path not found: $target"
    fi
done

mmdc="${MMDC_BIN:-$TOOLS_HOME/node_modules/.bin/mmdc}"
[[ -x "$mmdc" ]] || die "error" "mermaid-cli is not installed; run: npm ci (in $TOOLS_HOME)"

config="$(mktemp "${TMPDIR:-/tmp}/diagram-config.XXXXXX.json")"
browser="$(mktemp "${TMPDIR:-/tmp}/diagram-browser.XXXXXX.json")"
trap 'rm -f "$config" "$browser"' EXIT
node "$TOOLS_HOME/lib/diagram/config.ts" > "$config"
node "$TOOLS_HOME/lib/diagram/puppeteer.ts" > "$browser"

header "rendering" "${#sources[@]}"
failed=0
for src in "${sources[@]}"; do
    dir="$(cd "$(dirname "$src")" && pwd)"
    name="$(basename "$src")"
    out="${src%.mmd}.png"
    if (
        cd "$dir"
        "$mmdc" -i "$name" -o "${name%.mmd}.png" -c "$config" -p "$browser" \
            --size 3300 -b white
    ); then
        msg "$GREEN" "rendered" "$src ${DIM}→${RESET} $out"
    else
        msg "$RED" "failed" "$src"
        failed=$((failed + 1))
    fi
done

footer "rendered" "$(( ${#sources[@]} - failed ))" 0 "$failed"
(( failed == 0 ))
