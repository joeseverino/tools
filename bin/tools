#!/usr/bin/env bash
# tools <command> — umbrella command for the personal CLI tools
set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/init.sh" "" "$@"

# tools' subcommands read every config without having one of its own. Each
# config asserts its layout env var with ${VAR:?…}, which in bash kills the
# WHOLE shell from a sourced file (no, `|| true` doesn't catch it). We gate
# each source on the relevant env var so `doctor` can still report what's
# missing instead of dying at startup.
# shellcheck source=config/vault.sh
[[ -n "${NOTES_HOME-}"   ]] && source "$TOOLS_HOME/config/vault.sh"
# shellcheck source=config/backup.sh.example
[[ -n "${BACKUPS_HOME-}" ]] && source "$TOOLS_HOME/config/backup.sh"
source "$TOOLS_HOME/lib/doctor.sh"
# shellcheck source=lib/tools/describe.sh
source "$TOOLS_HOME/lib/tools/describe.sh"
# shellcheck source=lib/tools/engine.sh
source "$TOOLS_HOME/lib/tools/engine.sh"

TOOL_NAMES=()
for file in "$TOOLS_HOME/bin"/*; do
    if [[ -f "$file" && -x "$file" ]]; then
        TOOL_NAMES+=("$(basename "$file")")
    fi
done
INSTALL_DIR="${TOOLS_INSTALL_DIR:-$HOME/.local/bin}"

describe_spec() {
    desc_tool "tools" "Umbrella command for the personal CLI toolchain."
    desc_inventory "Core" 10
    desc_synopsis "tools <command> [options]"
    desc_effect read

    desc_cmd status   -- "One-screen health check across vault, inbox, and backup"
    desc_effect read +network
    desc_opt --json   -- "Machine-readable output (one JSON object)"

    desc_cmd doctor   -- "Verify environment, deps, and installed symlinks"
    desc_effect read +network
    desc_opt --all    -- "Cross-system rollup: also run hq doctor (exit 1 if any gate fails)"
    desc_opt --live   -- "Implies --all; also ask HQ for managed resources that have drifted from what it declares (hq drift, over SSH)"
    desc_opt --json   -- "Machine-readable output (one object, \"checks\" array)"

    desc_cmd check    -- "Run the full CI suite locally: lint, tests, bench"
    desc_effect local_write
    desc_opt --no-bench -- "Skip the bench scripts (the slowest step)"
    desc_opt --ci     -- "Run hermetically, as CI does: this checkout's bin first with the install dir off \$PATH (no stale shadow), an empty global/system git config (no leaked defaultBranch, aliases, or hooks), and the bats version surfaced. ship --check uses this mode; set TOOLS_CI_BATS_VERSION to fail on a bats version other than CI's."

    desc_cmd new      -- "Scaffold a new tool in bin/ with the house conventions"
    desc_effect local_write
    desc_pos name     -- "Name of the new tool (creates bin/<name>)"
    desc_opt --agent  -- "Scaffold a lightweight agent-facing tool that emits the versioned result envelope"
    desc_opt --verify -- "Generate derived surfaces and run the full non-benchmark check after scaffolding"

    desc_cmd install  -- "Create symlinks in \$INSTALL_DIR for every tool"
    desc_effect local_write

    desc_cmd describe -- "Emit the command surface of every tool as one JSON document (the emit-once contract)"
    desc_effect read
    desc_pos tool +optional -- "Describe just one tool (delegates to <tool> --describe)"
    desc_pos command +optional -- "With a tool, project its contract to one command — the token-minimal AI path (tools describe hq restart)"
    desc_opt --pretty -- "Indent the JSON for reading (default: compact, diff-stable)"
    desc_opt --repos  -- "Also fold in sibling repos' emitters (severino-vault-mcp, life)"
    desc_opt --tui    -- "Browse the whole toolchain in a full-screen explorer (aggregate only; / filters, Enter copies an invocation). Shorthand: 'tools tui'"
    desc_example "tools describe hq restart" -- "one command's contract — effect, args, examples"
    desc_example "tools tui" -- "interactive explorer over the whole toolchain (alias of describe --tui)"

    desc_cmd tui -- "Open the full-screen command-surface explorer (shorthand for 'describe --tui')"
    desc_effect read +interactive
    desc_opt --repos -- "Also fold in sibling repos' emitters (severino-vault-mcp, life)"
    desc_para "The human tier of the emit-once contract: a two-pane explorer over every tool and command, with / to filter, e to expand the selected command's full prose + examples, and Enter to copy a ready-to-paste invocation."

    desc_cmd generate -- "Regenerate contract-derived completions and README reference/inventory"
    desc_effect local_write
    desc_pos target +optional "{all,completions,readme}" -- "Generated surface (default: all)"
    desc_opt --check -- "Fail when generated files are stale; do not write"

    desc_cmd contracts -- "Inspect the producer → consumer contract graph and projection drift"
    desc_effect read
    desc_pos id +optional -- "Contract or projection id to inspect (default: complete graph)"
    desc_opt --check -- "Run every declared projection check and fail when any derived artifact is stale"
    desc_opt --json  -- "Emit the graph, source fingerprints, and projection status as JSON"
    desc_opt --scope SCOPE "{local,fleet,live}" -- "Maximum projection scope to inspect (default: fleet)"
    desc_para "Contracts are declared once in config/contracts.json. Owners emit source facts; consumers declare check and repair commands. This command discovers repository paths through the capability registry and never maintains a second fleet inventory."

    desc_cmd derive -- "Regenerate a declared consumer projection from its owner contract"
    desc_effect local_write
    desc_pos projection +optional -- "Projection id from tools contracts (omit only with --all)"
    desc_opt --all -- "Plan every repairable projection in scope; required for a batch"
    desc_opt --go -- "Execute the plan, then run each projection's declared check"
    desc_opt --json -- "Emit the plan or execution receipts as JSON"
    desc_opt --scope SCOPE "{local,fleet}" -- "Maximum projection scope to derive (default: local)"
    desc_para "Dry-run by default. Repairs are schema-limited to local writes and execute only owner-declared commands; remote writes and deploys cannot enter this generic path."

    desc_cmd reinstall -- "Reinstall a registered uv tool from its checkout and verify it matches the source"
    desc_effect local_write +network
    desc_pos repo +optional -- "Repository id from config/capabilities.json (default: every repo that declares an install)"
    desc_para "Runs each repository's declared install command, then compares the installed fingerprint with one computed from the checkout wherever the repository declares a fingerprint. A mismatch fails, so a stale install cannot pass for current."
    desc_example "tools reinstall severino-vault-mcp" -- "reinstall the vault MCP and verify it against source"

    desc_cmd bump-engine -- "Re-lock severino-vault-engine in every consumer repo and reinstall their uv tools"
    desc_effect local_write +network
    desc_opt --lock-only -- "Update the uv.lock files but skip the uv tool reinstalls"
    desc_para "The one flow for moving the fleet to a newer vault-engine: each consumer repo (the vault MCPs and the life CLI) gets 'uv lock --upgrade-package severino-vault-engine', then its uv tool reinstalled so the running servers match the new pin. The lock edits are left uncommitted — ship each consumer repo's bump through its own PR flow. 'tools doctor' gates the invariant this maintains: every consumer pins the same engine commit (engine lock parity)."
    desc_example "tools bump-engine" -- "move every declared engine consumer to current main and reinstall"

    desc_env TOOLS_HOME        -- "Read from ~/.zshrc; root of this repo"
    desc_env TOOLS_INSTALL_DIR -- "Override install target (default: ~/.local/bin)"
}

# ---------- status ----------

cmd_status() {
    local json=0
    [[ "${1:-}" == "--json" ]] && json=1

    # Gather every value first; render text or JSON from the same facts.
    local vault_ok=0 tree="" remote=""
    if [[ -d "${VAULT:-}" && -d "${VAULT:-}/.git" ]]; then
        vault_ok=1
        tree=$(vault_tree   "$VAULT")
        remote=$(vault_remote "$VAULT")
    fi

    local inbox_ok=0 pending=0
    if [[ -d "${INBOX_DIR:-}" ]]; then
        inbox_ok=1
        pending=$(inbox_count "$INBOX_DIR")
    fi

    local backup_ok=0 backup_repo=0 last_msg="" last_when=""
    if [[ -n "${BACKUPS_HOME:-}" ]]; then
        backup_ok=1
        if [[ -d "$BACKUPS_HOME/.git" ]]; then
            backup_repo=1
            last_msg=$(git -C "$BACKUPS_HOME" log -1 --pretty='%s' 2>/dev/null || echo "")
            last_when=$(git -C "$BACKUPS_HOME" log -1 --pretty='%cr' 2>/dev/null || echo "")
        fi
    fi

    if (( json )); then
        printf '{"ok":true,"vault":{"ok":%s,"tree":"%s","remote":"%s","path":"%s"},' \
            "$(json_bool "$vault_ok")" "$(json_escape "$tree")" \
            "$(json_escape "$remote")" "$(json_escape "${VAULT:-}")"
        printf '"inbox":{"ok":%s,"pending":%d},' "$(json_bool "$inbox_ok")" "$pending"
        printf '"backup":{"ok":%s,"git_repo":%s,"last_commit":"%s","last_commit_when":"%s"}}\n' \
            "$(json_bool "$((backup_ok && backup_repo))")" "$(json_bool "$backup_repo")" \
            "$(json_escape "$last_msg")" "$(json_escape "$last_when")"
        return 0
    fi

    echo

    if (( vault_ok )); then
        local tree_color="$GREEN" remote_color="$GREEN"
        [[ "$tree"   != "clean"   ]] && tree_color="$YELLOW"
        [[ "$remote" != "in sync" ]] && remote_color="$YELLOW"
        msg "$RESET" "vault" "${tree_color}${tree}${RESET}, ${remote_color}${remote}${RESET} ${DIM}($VAULT)${RESET}"
    else
        msg "$RED" "vault" "not a git repo or VAULT not set"
    fi

    if (( inbox_ok )); then
        if (( pending > 0 )); then
            msg "$YELLOW" "inbox" "$pending pending note$([[ $pending -eq 1 ]] || echo s)"
        else
            msg "$GREEN" "inbox" "empty"
        fi
    else
        msg "$RED" "inbox" "INBOX_DIR not set or missing"
    fi

    if (( backup_repo )); then
        if [[ -n "$last_msg" ]]; then
            msg "$GREEN" "backup" "last commit ${DIM}${last_when}${RESET} — $last_msg"
        else
            msg "$YELLOW" "backup" "no commits yet"
        fi
    elif (( backup_ok )); then
        msg "$YELLOW" "backup" "$BACKUPS_HOME ${DIM}(not a git repo)${RESET}"
    else
        msg "$RED" "backup" "BACKUPS_HOME not set"
    fi

    echo
}

# ---------- doctor ----------
# check/check_warn/gate/doctor_finish live in lib/doctor.sh (shared plumbing
# + the cross-system gate registry behind --all).

cmd_doctor() {
    local fail=0 run_all=0 run_live=0
    DOCTOR_JSON=0
    DOCTOR_CHECKS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --json) DOCTOR_JSON=1 ;;
            --all)  run_all=1 ;;
            --live) run_all=1; run_live=1 ;;
            *) die_unknown option "$1" doctor ;;
        esac
        shift
    done
    (( DOCTOR_JSON )) || echo

    # Layout env vars
    for var in TOOLS_HOME NOTES_HOME BACKUPS_HOME; do
        if [[ -n "${!var:-}" ]]; then
            check "\$$var" 1 "${!var}" || fail=1
        else
            check "\$$var" 0 "not exported in current shell" || fail=1
        fi
    done

    # Resolved paths. Plain if/else — the [[ ]] && a || b shorthand drops
    # commands inside the `b` branch under `set -e`, so the function would
    # exit early on the first missing path.
    check_path() {
        local kind="$1" label="$2" path="${3:-}"
        local ok=0
        if [[ -n "$path" ]]; then
            [[ "$kind" == "d" && -d "$path" ]] && ok=1
            [[ "$kind" == "f" && -f "$path" ]] && ok=1
        fi
        if (( ok )); then
            check "$label" 1 "$path" || fail=1
        else
            check "$label" 0 "${path:-unset}" || fail=1
        fi
    }
    check_path d "VAULT directory" "${VAULT:-}"
    check_path d "INBOX_DIR"       "${INBOX_DIR:-}"

    # External deps
    for cmd in git rsync uv; do
        if command -v "$cmd" >/dev/null; then
            check "$cmd" 1 "$(command -v "$cmd")" || fail=1
        else
            check "$cmd" 0 "not installed" || fail=1
        fi
    done

    # 1Password is the credential store; hq reads its env through it. Doctor
    # never reads a secret or raises an item prompt.
    if command -v op >/dev/null; then
        check "1Password CLI" 1 "$(command -v op)"
    else
        check "1Password CLI" 0 "not installed — install the 1Password CLI" || fail=1
    fi

    # Node toolchain — optional: only doc-to-pdf, diagram, and the TUIs need
    # it, so a missing node warns instead of failing.
    if command -v node >/dev/null; then
        check "node" 1 "$(command -v node)"
        if [[ -f "$TOOLS_HOME/package.json" && ! -d "$TOOLS_HOME/node_modules" ]]; then
            check_warn "node_modules" "missing — run: npm ci (needed by doc-to-pdf and diagram)"
        fi
    else
        check_warn "node" "not installed — doc-to-pdf, diagram, and the TUIs need it"
    fi

    # Command-surface contract — every tool must self-describe (the emit-once
    # contract: -h and --describe both render from one describe_spec, so they
    # can't drift; this catches a tool that forgot to wire --describe). Layout
    # vars are defaulted for the probe so an unset env (reported separately
    # above) doesn't masquerade as a missing contract.
    local desc_missing="" dout
    for name in "${TOOL_NAMES[@]}"; do
        if dout=$(NOTES_HOME="${NOTES_HOME:-$TOOLS_HOME}" \
                  BACKUPS_HOME="${BACKUPS_HOME:-$TOOLS_HOME}" \
                  "$TOOLS_HOME/bin/$name" --describe 2>/dev/null) \
            && [[ "$dout" == '{"ok":true'* ]]; then
            continue
        fi
        desc_missing+="$name "
    done
    if [[ -z "$desc_missing" ]]; then
        check "tools self-describe" 1 "${#TOOL_NAMES[@]} tools emit --describe"
    else
        check "tools self-describe" 0 "no --describe contract: ${desc_missing% }" || fail=1
    fi

    # Contract owners and projections are declared once in the graph. Doctor
    # consumes its verdict instead of growing bespoke cross-repo drift logic.
    local contract_result contract_ok=0 contract_detail=""
    local contract_scope="local"
    (( run_all )) && contract_scope="fleet"
    (( run_live )) && contract_scope="live"
    contract_result=$(node "$TOOLS_HOME/lib/tools/contracts.ts" --check --scope "$contract_scope" --json 2>/dev/null) || true
    if [[ -n "$contract_result" ]]; then
        contract_ok=$(node -e 'const x=JSON.parse(process.argv[1]); process.stdout.write(x.ok ? "1" : "0")' "$contract_result")
        contract_detail=$(node -e 'const x=JSON.parse(process.argv[1]); const p=x.projections; process.stdout.write(p.filter(v=>v.ok&&!v.skipped).length+" current, "+p.filter(v=>v.skipped).length+" unavailable")' "$contract_result")
    fi
    check "contract projections" "$contract_ok" "${contract_detail:-contract graph unavailable}" || fail=1

    # Every vault-engine consumer must pin the SAME engine commit — skew means
    # a schema/core change reached one consumer and not the others silently.
    # The consumer list and lock parse live in lib/tools/engine.sh, shared with
    # `tools bump-engine` (the fix this check points at).
    local -a engine_repos=()
    local engine_repo engine_pin engine_first="" engine_skew=0 engine_missing="" engine_detail=""
    while IFS= read -r engine_repo; do engine_repos+=("$engine_repo"); done < <(engine_consumers)
    for engine_repo in "${engine_repos[@]}"; do
        if [[ ! -f "$engine_repo/uv.lock" ]]; then
            engine_missing+="$(basename "$engine_repo") "
            continue
        fi
        engine_pin="$(engine_lock_pin "$engine_repo")"
        engine_detail+="$(basename "$engine_repo") pins ${engine_pin:-nothing}, "
        if [[ -z "$engine_first" ]]; then engine_first="$engine_pin"; fi
        if [[ -z "$engine_pin" || "$engine_pin" != "$engine_first" ]]; then engine_skew=1; fi
    done
    if [[ -n "$engine_missing" ]]; then
        check_warn "engine lock parity" "uv.lock not found for: ${engine_missing% }— parity not checked"
    elif (( ! engine_skew )); then
        check "engine lock parity" 1 "all ${#engine_repos[@]} consumers pin severino-vault-engine $engine_first"
    else
        check "engine lock parity" 0 "${engine_detail%, } — run: tools bump-engine" || fail=1
    fi

    # Installed uv tools must match their checkouts, or a stale install answers
    # for code that has moved on. The fix is the command this points at.
    local -a installed_line=()
    local installed_detail="" installed_stale=""
    while IFS=$'\t' read -r -a installed_line; do
        case "${installed_line[1]}" in
            match) installed_detail+="${installed_line[0]} ${installed_line[2]}, " ;;
            skip)  ;;
            *)     installed_stale+="${installed_line[0]} (${installed_line[2]}) " ;;
        esac
    done < <(node "$TOOLS_HOME/lib/tools/capabilities.ts" fingerprints 2>/dev/null)
    if [[ -n "$installed_stale" ]]; then
        check "installed tools" 0 "${installed_stale% } — run: tools reinstall" || fail=1
    elif [[ -n "$installed_detail" ]]; then
        check "installed tools" 1 "${installed_detail%, } match source"
    fi

    # Symlinks in install dir (top-level tools + lib helpers)
    for name in "${TOOL_NAMES[@]}"; do
        local link="$INSTALL_DIR/$name"
        if [[ -L "$link" ]]; then
            local target
            target="$(readlink "$link")"
            if [[ "$target" == "$TOOLS_HOME/bin/$name" ]]; then
                check "$name symlink" 1 "$link"
            else
                check "$name symlink" 0 "points to $target, expected $TOOLS_HOME/bin/$name"
                fail=1
            fi
        else
            check "$name symlink" 0 "not in $INSTALL_DIR (run: tools install)"
            fail=1
        fi
    done

    # The cross-system rollup: each system's own gate, from the registry in
    # lib/doctor.sh. Exit codes are the contract; detail stays in each tool.
    if (( run_all )); then
        if (( ! DOCTOR_JSON )); then
            echo
            printf '  %ssystems%s\n' "$BOLD" "$RESET"
        fi
        doctor_gates || fail=1
        if (( run_live )); then
            doctor_live_gates || fail=1
        else
            check_warn "hq drift" "skipped — asks HQ over SSH; rerun with --live"
        fi
    fi

    doctor_finish "$fail"
}

# ---------- install ----------

cmd_install() {
    mkdir -p "$INSTALL_DIR"
    echo
    local created=0 updated=0 skipped=0
    for name in "${TOOL_NAMES[@]}"; do
        local src="$TOOLS_HOME/bin/$name" dst="$INSTALL_DIR/$name"
        [[ -x "$src" ]] || { msg "$RED" "skipped" "$name ${DIM}(not executable at $src)${RESET}"; skipped=$((skipped+1)); continue; }
        if [[ -L "$dst" ]]; then
            local current
            current="$(readlink "$dst")"
            if [[ "$current" == "$src" ]]; then
                msg "$DIM" "ok" "$name ${DIM}(already linked)${RESET}"
                skipped=$((skipped+1))
                continue
            fi
            ln -sf "$src" "$dst"
            msg "$YELLOW" "updated" "$name ${DIM}→ $src${RESET}"
            updated=$((updated+1))
        elif [[ -e "$dst" ]]; then
            msg "$RED" "skipped" "$name ${DIM}($dst exists, not a symlink)${RESET}"
            skipped=$((skipped+1))
        else
            ln -s "$src" "$dst"
            msg "$GREEN" "linked" "$name ${DIM}→ $src${RESET}"
            created=$((created+1))
        fi
    done
    echo
    printf '  %sinstall%s    %d created, %d updated, %d skipped\n\n' \
        "$BOLD" "$RESET" "$created" "$updated" "$skipped"
    case ":$PATH:" in
        *":$INSTALL_DIR:"*) ;;
        *) printf "  %snote%s       %s is not on \$PATH — add it in ~/.zshrc\n\n" \
            "$BOLD$YELLOW" "$RESET" "$INSTALL_DIR" ;;
    esac
}

cmd_generate() {
    local target="all" check_only=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check) check_only=1 ;;
            all|completions|readme) target="$1" ;;
            -*) die_unknown option "$1" generate ;;
            *) die_unknown target "$1" generate ;;
        esac
        shift
    done
    local args=("$target")
    (( check_only )) && args+=(--check)
    node "$TOOLS_HOME/lib/tools/generate-surfaces.ts" "${args[@]}"
}

# ---------- contracts (producer → consumer graph) ----------

cmd_contracts() {
    local -a args=()
    local id=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --check|--json) args+=("$1") ;;
            --scope)
                [[ -n "${2:-}" ]] || die "usage" "tools contracts --scope <local|fleet|live>" 2
                args+=("$1" "$2"); shift ;;
            -*) die_unknown option "$1" contracts ;;
            *)
                [[ -z "$id" ]] || die "usage" "tools contracts accepts one contract or projection id" 2
                id="$1"; args+=("$1") ;;
        esac
        shift
    done
    node "$TOOLS_HOME/lib/tools/contracts.ts" "${args[@]}"
}

cmd_derive() {
    node "$TOOLS_HOME/lib/tools/derive.ts" "$@"
}

# ---------- check (the CI suite, runnable locally) ----------
# CI calls `tools check` so the definition of "passing" lives in exactly
# one place. Tools are discovered by shebang — adding a file to bin/ adds
# it to every check automatically.

# Surface the bats version under --ci — a recurring local↔CI divergence (1.13's
# last-command-only errexit masked stale assertions) — and, when
# TOOLS_CI_BATS_VERSION is set (the pin CI exports), fail on any other version.
ci_bats_check() {
    local want="${TOOLS_CI_BATS_VERSION:-}" have
    if ! command -v bats >/dev/null; then
        check "bats version" 0 "bats not installed (brew install bats-core)"
        return 1
    fi
    have="$(bats --version 2>/dev/null | awk '{print $NF}')"
    if [[ -n "$want" && "$have" != "$want" ]]; then
        check "bats version" 0 "have $have, CI pins $want (TOOLS_CI_BATS_VERSION)"
        return 1
    fi
    check "bats version" 1 "$have${want:+ · pinned}"
}

cmd_check() {
    local run_bench=1 fail=0 ci=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --no-bench) run_bench=0; shift ;;
            --ci)       ci=1; shift ;;
            *) die_unknown option "$1" check ;;
        esac
    done

    # --ci: make the local gate byte-for-byte CI. The CI-equivalent environment
    # is defined once in lib/common.sh (shared with the bats harness) and applied
    # here in-process, so every step below and every child it spawns (shellcheck,
    # bats, bench, generate, sibling tools) inherits it. local must equal CI.
    (( ci )) && ci_shell_env

    cd "$TOOLS_HOME"
    echo
    local f n err step_ok
    if (( ci )); then
        msg "$DIM" "ci" "hermetic gate · repo bin first, install dir off \$PATH · clean git config"
        ci_bats_check || fail=1
    fi

    # bash -n
    step_ok=1; n=0
    for f in bin/* bench/*.sh; do
        shebang_has bash "$f" || continue
        n=$((n+1))
        if ! err=$(bash -n "$f" 2>&1); then
            msg "$RED" "fail" "bash -n $f"
            printf '%s\n' "$err" | sed 's/^/    /'
            step_ok=0
        fi
    done
    check "bash -n" "$step_ok" "$n scripts" || fail=1

    # zsh -n
    step_ok=1; n=0
    for f in bin/*; do
        shebang_has zsh "$f" || continue
        n=$((n+1))
        if ! err=$(zsh -n "$f" 2>&1); then
            msg "$RED" "fail" "zsh -n $f"
            printf '%s\n' "$err" | sed 's/^/    /'
            step_ok=0
        fi
    done
    check "zsh -n" "$step_ok" "$n scripts" || fail=1

    # TypeScript: every lib module type-checks under the strict tsconfig (Node
    # runs the same files directly, so this is the whole compile step).
    if [[ -x "$TOOLS_HOME/node_modules/.bin/tsc" ]]; then
        if err=$("$TOOLS_HOME/node_modules/.bin/tsc" -p "$TOOLS_HOME" 2>&1); then
            check "typecheck" 1 "$(git ls-files 'lib/*.ts' 'lib/**/*.ts' | wc -l | tr -d ' ') modules, strict"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "typecheck" 0 "errors above" || fail=1
        fi
    else
        check "typecheck" 0 "run npm ci (TypeScript is required)" || fail=1
    fi

    # Contract schema + generated consumers. The validator checks every real
    # emitter against schemas/cordon-v4.json (via lib/tools/describe-schema.ts) —
    # including sibling repos'
    # emitters via --repos, so a drifted `severino-vault-mcp describe` fails here
    # (the cross-repo drift guard). When the sibling isn't installed, --repos just
    # folds in nothing. The generator check keeps completions + README current.
    if command -v node >/dev/null && [[ -d "$TOOLS_HOME/node_modules/ajv" ]]; then
        if err=$("$TOOLS_HOME/bin/tools" describe --repos | node "$TOOLS_HOME/lib/tools/validate-describe.ts" 2>&1); then
            check "describe schema" 1 "$err"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "describe schema" 0 "validation errors above" || fail=1
        fi
        if err=$(node "$TOOLS_HOME/lib/tools/validate-json.ts" "$TOOLS_HOME/schemas/capabilities-v1.json" < "$TOOLS_HOME/config/capabilities.json" 2>&1); then
            check "capability schema" 1 "fleet manifest valid"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "capability schema" 0 "validation errors above" || fail=1
        fi
        if err=$(node "$TOOLS_HOME/lib/tools/validate-json.ts" "$TOOLS_HOME/schemas/contract-graph-v1.json" < "$TOOLS_HOME/config/contracts.json" 2>&1); then
            check "contract graph schema" 1 "producer/consumer graph valid"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "contract graph schema" 0 "validation errors above" || fail=1
        fi
        if err=$(node "$TOOLS_HOME/lib/tools/contracts.ts" --check --scope local --json 2>&1); then
            check "contract projections" 1 "all declared projections current"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "contract projections" 0 "run: tools contracts --check" || fail=1
        fi
    else
        check "describe schema" 0 "run npm ci (Ajv is required)" || fail=1
    fi

    # Lint tracked shell sources only; local config/*.sh copies are
    # user-specific and would make the check non-reproducible.
    if command -v shellcheck >/dev/null; then
        local sc_targets=()
        for f in bin/* bench/*.sh; do
            shebang_has bash "$f" && sc_targets+=("$f")
        done
        # lib/*.sh and config/*.sh have no shebang to route on, so discover them
        # via git: tracked or new-but-unignored sources are linted, while
        # gitignored user-local config copies (backup.sh, site.sh, ...) are not.
        # New files (a new lib helper or config/<tool>.sh) are covered
        # automatically — no hand-editing here.
        while IFS= read -r f; do
            [[ -f "$f" ]] && sc_targets+=("$f")
        done < <(git ls-files --cached --others --exclude-standard \
                     'lib/*.sh' 'config/*.sh' 'config/*.sh.example')
        if err=$(shellcheck -x "${sc_targets[@]}" 2>&1); then
            check "shellcheck" 1 "${#sc_targets[@]} files"
        else
            printf '%s\n' "$err" | sed 's/^/    /'
            check "shellcheck" 0 "findings above" || fail=1
        fi
    else
        check "shellcheck" 0 "not installed (brew install shellcheck)" || fail=1
    fi

    # bats tests
    if [[ -d tests ]]; then
        if command -v bats >/dev/null; then
            if err=$(bats tests 2>&1); then
                check "bats tests" 1 "$(printf '%s\n' "$err" | grep -c '^ok') passed"
            else
                printf '%s\n' "$err" | sed 's/^/    /'
                check "bats tests" 0 "failures above" || fail=1
            fi
        else
            check "bats tests" 0 "bats not installed (brew install bats-core)" || fail=1
        fi
    fi

    # bench — each script asserts its own claim and exits nonzero on regression
    if (( run_bench )); then
        for f in bench/*.sh; do
            if err=$("./$f" 2>&1); then
                check "bench ${f##*/}" 1
            else
                printf '%s\n' "$err" | tail -20 | sed 's/^/    /'
                check "bench ${f##*/}" 0 "output above" || fail=1
            fi
        done
    fi

    echo
    if (( fail )); then
        printf '  %scheck%s     one or more checks failed\n\n' "$BOLD$RED" "$RESET"
        return 1
    fi
    printf '  %scheck%s     all checks passed\n\n' "$BOLD$GREEN" "$RESET"
}

# ---------- new (scaffold a tool with the house conventions) ----------

cmd_new() {
    local name="" agent=0 verify=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent)    agent=1; shift ;;
            --verify)   verify=1; shift ;;
            -*)         die_unknown option "$1" new ;;
            *)          name="$1"; shift ;;
        esac
    done
    [[ -n "$name" ]] || die "usage" "tools new <name> [--agent] [--verify] (try -h)" 2
    [[ "$name" =~ ^[a-z][a-z0-9-]*$ ]] || die "usage" "name must be lowercase letters, digits, dashes" 2
    local target="$TOOLS_HOME/bin/$name"
    [[ -e "$target" ]] && die "error" "bin/$name already exists"
    local order
    order=$("$TOOLS_HOME/bin/tools" describe | node -e '
let input = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", chunk => input += chunk);
process.stdin.on("end", () => {
  const tools = JSON.parse(input).tools || [];
  const max = Math.max(0, ...tools.map(tool => Number(tool.order) || 0));
  process.stdout.write(String(Math.ceil(max / 10) * 10 + 10));
});
')

    if (( agent )); then
        new_agent "$name" "$target" "$order" "$verify"
        return 0
    fi

    cat > "$target" <<'EOF'
#!/usr/bin/env bash
# __NAME__ <args> — one-line description
set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/init.sh" "" "$@"

# The single source of truth for __NAME__'s surface: lib/describe.sh renders
# both this tool's -h text and its --describe JSON from this one declaration.
describe_spec() {
    desc_tool "__NAME__" "One-line description of __NAME__."
    desc_inventory "Other" __ORDER__
    desc_synopsis "__NAME__ [options] <args>"
    # Declare blast radius explicitly; never infer a missing classification:
    desc_effect read
    #   desc_effect local_write             # writes local files
    #   desc_effect vault_write             # mutates the Obsidian vault
    #   desc_effect remote_write +network   # mutates a remote system over the network
    #   desc_effect deploy +network         # ships / restarts a service
    # +interactive marks a command that blocks on a TTY. On a subcommand tool,
    # put desc_effect right after every desc_cmd; here it classifies the leaf tool.
    # desc_opt -x --example METAVAR -- "what the flag does"
    # desc_pos arg -- "what the positional is"
    # desc_para "One logical paragraph as a single unwrapped string; renderers
    #            reflow it. One desc_para per paragraph — never split a sentence."
}

desc_help_intercept "$@"

echo
msg "$GREEN" "todo" "implement __NAME__"
echo
EOF
    sed -i '' "s/__NAME__/$name/g" "$target"
    sed -i '' "s/__ORDER__/$order/g" "$target"
    chmod +x "$target"

    echo
    msg "$GREEN" "created" "bin/$name"
    msg "$DIM"   "next"    "1. implement it (tool-specific files go in lib/$name/)"
    if (( verify )); then
        msg "$DIM" "verify" "generating surfaces and running tools check --no-bench"
        cmd_generate all
        cmd_check --no-bench
        msg "$DIM" "next" "tools install"
    else
        msg "$DIM" "next" "2. tools generate && tools install"
        msg "$DIM" "next" "3. tools check"
    fi
    echo
}

new_agent() {
    local name="$1" target="$2" order="$3" verify="${4:-0}"
    cat > "$target" <<'EOF'
#!/usr/bin/env bash
# __NAME__ — lightweight agent-facing utility with a governed result envelope.
set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/sdk.sh"

describe_spec() {
    desc_tool "__NAME__" "One-line description of __NAME__."
    desc_inventory "Other" __ORDER__
    desc_synopsis "__NAME__ [options]"
    desc_effect read
    desc_para "Emits the Severino Tools result-v1 envelope so agents and scripts receive stable success, error, warning, receipt, and next-action fields."
}

desc_help_intercept "$@"

# Replace this payload with domain logic. For a failure:
# result_error "invalid_input" "explain what was wrong" 0
result_ok '{"message":"implement __NAME__"}'
EOF
    sed -i '' "s/__NAME__/$name/g" "$target"
    sed -i '' "s/__ORDER__/$order/g" "$target"
    chmod +x "$target"
    echo
    msg "$GREEN" "created" "bin/$name (agent result-v1 template)"
    if (( verify )); then
        cmd_generate all
        cmd_check --no-bench
    else
        msg "$DIM" "next" "implement the handler, then tools generate && tools check"
    fi
    echo
}

# ---------- bump-engine (move the vault-engine consumer fleet together) ----------
# Consumer list + lock parse live in lib/tools/engine.sh, shared with the
# doctor's "engine lock parity" check — one definition, two faces.

cmd_bump_engine() {
    local lock_only=0 uv="${UV_BIN:-uv}"
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --lock-only) lock_only=1 ;;
            *) die_unknown option "$1" bump-engine ;;
        esac
        shift
    done
    command -v "$uv" >/dev/null || die "error" "uv not installed"
    local -a repos=() ids=()
    local repo name before after changed=0 i
    while IFS=$'\t' read -r name repo; do ids+=("$name"); repos+=("$repo"); done \
        < <(node "$TOOLS_HOME/lib/tools/capabilities.ts" pairs engine_consumer)
    for i in "${!repos[@]}"; do
        repo="${repos[$i]}" name="${ids[$i]}"
        [[ -f "$repo/uv.lock" ]] || die "error" "no uv.lock at $repo (set MCP_HOME / LIFE_MCP_HOME)"
        before="$(engine_lock_pin "$repo")"
        msg "$DIM" "step" "$name: uv lock --upgrade-package severino-vault-engine"
        (cd "$repo" && "$uv" lock --upgrade-package severino-vault-engine)
        after="$(engine_lock_pin "$repo")"
        if [[ "$after" == "$before" ]]; then
            msg "$GREEN" "ok" "$name already pins ${after:-nothing}"
        else
            msg "$GREEN" "bumped" "$name: ${before:-nothing} -> $after"
            changed=1
        fi
        if (( ! lock_only )); then
            reinstall_repo "$name" || die "error" "$name: reinstall failed"
        fi
    done
    local pin_first pin_this skew=0 detail=""
    pin_first="$(engine_lock_pin "${repos[0]}")"
    for repo in "${repos[@]}"; do
        pin_this="$(engine_lock_pin "$repo")"
        detail+="$(basename "$repo") pins ${pin_this:-nothing}, "
        [[ "$pin_this" != "$pin_first" ]] && skew=1
    done
    if (( skew )); then
        die "error" "consumers still disagree after the bump: ${detail%, }" 1
    fi
    if (( changed )); then
        msg "$YELLOW" "note" "uv.lock changed — ship each consumer repo's lock bump through its own PR flow"
    fi
    msg "$GREEN" "engine" "all ${#repos[@]} consumers pin severino-vault-engine ${pin_first:-nothing}"
}

# ---------- reinstall (uv tools from their checkouts) ----------
# The install command and fingerprint come from config/capabilities.json; one
# path serves `tools reinstall`, `tools bump-engine`, and the doctor check.

reinstall_repo() {
    local id="$1" plan path verdict
    plan="$(node "$TOOLS_HOME/lib/tools/capabilities.ts" install "$id")" \
        || die "error" "$id declares no install in config/capabilities.json"
    path="${plan%%$'\t'*}"
    local -a argv=()
    IFS=$'\t' read -r -a argv <<<"${plan#*$'\t'}"
    [[ -d "$path" ]] || die "error" "$id checkout not found: $path"
    [[ "${argv[0]}" == uv ]] && argv[0]="${UV_BIN:-uv}"
    command -v "${argv[0]}" >/dev/null || die "error" "$id installs with ${argv[0]}, which is not installed"
    msg "$DIM" "step" "$id: ${argv[*]}"
    (cd "$path" && "${argv[@]}")
    verdict="$(node "$TOOLS_HOME/lib/tools/capabilities.ts" fingerprints "$id")"
    case "$(cut -f2 <<<"$verdict")" in
        match) msg "$GREEN" "reinstalled" "$id $(cut -f3 <<<"$verdict")" ;;
        skip)  msg "$GREEN" "reinstalled" "$id" ;;
        *)     msg "$RED" "stale" "$id: $(cut -f3 <<<"$verdict")"; return 1 ;;
    esac
}

cmd_reinstall() {
    local -a ids=()
    local id
    if [[ $# -gt 0 ]]; then
        [[ "$1" == -* ]] && die_unknown option "$1" reinstall
        ids=("$1")
    else
        while IFS= read -r id; do ids+=("$id"); done \
            < <(node "$TOOLS_HOME/lib/tools/capabilities.ts" ids install)
    fi
    local fail=0
    for id in "${ids[@]}"; do reinstall_repo "$id" || fail=1; done
    (( ! fail )) || die "error" "an installed tool still differs from its source" 1
    msg "$DIM" "note" "reconnect long-running MCP clients only if their tool schema must refresh"
}

# All help + the machine surface render from the one spec via the shared
# intercept (main `-h`, `--describe`, focused `<cmd> -h`) — so even
# `tools status -h` / `tools install -h` render help instead of acting.
desc_help_intercept "$@"
case "${1:-}" in
    status)        shift; cmd_status   "$@" ;;
    doctor)        shift; cmd_doctor   "$@" ;;
    check)         shift; cmd_check    "$@" ;;
    new)           shift; cmd_new      "$@" ;;
    install)       shift; cmd_install  "$@" ;;
    describe)      shift; cmd_describe "$@" ;;
    tui)           shift; cmd_describe --tui "$@" ;;
    generate)      shift; cmd_generate "$@" ;;
    contracts)     shift; cmd_contracts "$@" ;;
    derive)        shift; cmd_derive "$@" ;;
    reinstall)     shift; cmd_reinstall "$@" ;;
    bump-engine)   shift; cmd_bump_engine "$@" ;;
    *)             die_unknown command "$1" ;;
esac
