#!/usr/bin/env bash
# ts-acl — fetch the live Tailscale ACL and diff it against the vault cache.
# Drift-guard sibling of cf-dns / adguard; the show/diff/pull mechanics live in
# lib/drift.sh. Uses a read-only (acl:read) OAuth client resolved from
# 1Password through the shared logical-secret registry.
set -euo pipefail

source "${TOOLS_HOME:?set in ~/.zshrc}/lib/init.sh" "ts-acl" "$@"
# shellcheck source=lib/drift.sh
source "$TOOLS_HOME/lib/drift.sh"

API="https://api.tailscale.com/api/v2"
# New model: the cache is the `tailscale_acl` JSON file in the infra-dataset
# registry, read/written through the vault MCP. drift.sh keys off DRIFT_DATASET_ID.
DRIFT_DATASET_ID="${TS_ACL_DATASET_ID:-tailscale_acl}"

describe_spec() {
    desc_tool "ts-acl" "Fetch the live Tailscale ACL policy and diff it against the vault cache."
    desc_inventory "Drift guards" 90
    desc_synopsis "ts-acl <command>"
    drift_describe_commands
    desc_env TS_TAILNET       -- "tailnet to query (default \"-\": the credential's own)"
    desc_env TS_ACL_DATASET_ID -- "infra-dataset id for the cache (default tailscale_acl)"
}

# Exchange the registered read-only OAuth client for a short-lived Bearer.
get_token() {
    local id secret resp token
    id=$(secret_read tailscale.oauth_client_id)
    secret=$(secret_read tailscale.oauth_client_secret)
    resp=$(curl -fsS "$API/oauth/token" \
                -d "client_id=$id" \
                -d "client_secret=$secret" \
                -d "grant_type=client_credentials" 2>/dev/null) \
        || die "error" "OAuth token request failed (check client is valid / not revoked)"

    token=$(jq -r '.access_token // empty' <<<"$resp")
    [[ -n $token ]] || die "error" "no access_token in OAuth response"
    echo "$token"
}

# Fetch the live ACL policy, normalized.
fetch_live() {
    local token; token=$(get_token)
    curl -fsS "$API/tailnet/$TS_TAILNET/acl" \
         -H "Authorization: Bearer $token" \
         -H "Accept: application/json" 2>/dev/null \
        | normalize \
        || die "error" "ACL fetch failed"
}

# The ACL is a single JSON policy object; normalize = sort keys. Idempotent.
normalize() {
    jq -S '.'
}

drift_main "$@"
