{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joeseverino/tools/main/schemas/secrets-v1.json",
  "title": "Severino Tools logical secret registry v1",
  "type": "object",
  "required": ["schema_version", "provider", "secrets"],
  "properties": {
    "schema_version": { "const": 1 },
    "provider": { "const": "1password" },
    "secrets": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "string",
        "pattern": "^op://[^/]+/[^/]+/[^/]+$"
      }
    }
  },
  "additionalProperties": false
}
