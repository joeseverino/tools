{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/joeseverino/tools/main/schemas/contract-graph-v1.json",
  "title": "Severino Contract Graph v1",
  "type": "object",
  "required": ["contract_graph_version", "contracts", "projections"],
  "properties": {
    "contract_graph_version": { "const": 1 },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "owner", "description", "source"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "owner": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1 },
          "source": { "$ref": "#/$defs/source" }
        },
        "additionalProperties": false
      }
    },
    "projections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "contract", "consumer", "description", "scope", "check"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "contract": { "$ref": "#/$defs/id" },
          "consumer": { "$ref": "#/$defs/id" },
          "description": { "type": "string", "minLength": 1 },
          "scope": { "enum": ["local", "fleet", "live"] },
          "check": { "$ref": "#/$defs/command" },
          "repair": { "$ref": "#/$defs/command" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "command": {
      "type": "object",
      "required": ["repository", "argv"],
      "properties": {
        "repository": { "$ref": "#/$defs/id" },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "required": ["repository", "path"],
          "properties": {
            "repository": { "$ref": "#/$defs/id" },
            "path": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["repository", "capability"],
          "properties": {
            "repository": { "$ref": "#/$defs/id" },
            "capability": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" }
          },
          "additionalProperties": false
        },
        { "$ref": "#/$defs/command" }
      ]
    }
  },
  "additionalProperties": false
}
