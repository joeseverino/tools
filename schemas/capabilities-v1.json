{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.severino.dev/tools/capabilities-v1.json",
  "title": "Severino Fleet Capabilities v1",
  "type": "object",
  "required": ["capabilities_version", "repositories"],
  "properties": {
    "capabilities_version": { "const": 1 },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "path": { "type": "string", "minLength": 1 },
          "describe": { "$ref": "#/$defs/command" },
          "brief_section": { "$ref": "#/$defs/command" },
          "engine_consumer": { "type": "boolean" },
          "install": { "$ref": "#/$defs/command" },
          "schema_contract": { "$ref": "#/$defs/command" },
          "schema_fingerprint": { "$ref": "#/$defs/command" }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "command": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    }
  },
  "additionalProperties": false
}
