# shellcheck shell=bash
# config/hq.sh — configuration for the hq tool
#
# Copy to config/hq.sh and fill in the local values. Sourced by `hq`; each
# variable can be overridden per-invocation. The real file is not tracked:
# the checkout paths and host alias below are specific to one machine and one
# operator.

: "${NOTES_HOME:?set in ~/.zshrc}"

# Vault root we walk for frontmatter.
: "${VAULT:=$NOTES_HOME}"

# Local checkout of the HQ app. `hq schema` writes its docs_index/schema.json.
: "${CODE_HOME:?set by lib/sdk/core.sh}"
: "${HQ_LOCAL_PATH:=$CODE_HOME/Projects/severino-hq}"

# Human-readable frontmatter contract doc in the vault. `hq schema` checks its
# enum lists against the canonical MCP schema so it can't silently drift.
: "${HQ_SCHEMA_DOC:=$VAULT/02 Infrastructure/Severino HQ/Frontmatter Schema.md}"

# SSH alias of the server where Severino HQ runs. Set in your ~/.zshrc to
# match the entry in your ~/.ssh/config — e.g. `export HQ_SSH_HOST=hq-host`.
: "${HQ_SSH_HOST:=}"

# HQ's tools are called as the operator, through a shell on HQ_SSH_HOST: your
# own SSH certificate and agent, no shared token. Agents use MCP under their
# own identities. The defaults live with the transport (lib/hq-call); set these
# only to override.
# export HQ_CONTAINER=<container name on HQ_SSH_HOST, default severino-hq>
# export HQ_CALL=<an alternative transport, e.g. a test double>
