{
  "contract_graph_version": 1,
  "contracts": [
    {
      "id": "cordon.command-surface.v4",
      "owner": "cordon",
      "description": "Canonical Cordon v4 command-surface schema.",
      "source": {
        "repository": "tools",
        "path": "node_modules/cordon-spec/schema/cordon-v4.json"
      }
    },
    {
      "id": "tools.command-inventory.v4",
      "owner": "tools",
      "description": "Local command inventory emitted from every Tools Cordon surface.",
      "source": {
        "repository": "tools",
        "argv": ["bin/tools", "describe"]
      }
    }
  ],
  "projections": [
    {
      "id": "tools.cordon-schema-v4",
      "contract": "cordon.command-surface.v4",
      "consumer": "tools",
      "description": "Vendored Cordon schema used by hermetic validation.",
      "check": {
        "repository": "tools",
        "argv": ["node", "lib/tools/check-cordon-schema.mjs"]
      }
    },
    {
      "id": "tools.generated-surfaces",
      "contract": "tools.command-inventory.v4",
      "consumer": "tools",
      "description": "README inventory/reference and shell completions.",
      "check": {
        "repository": "tools",
        "argv": ["bin/tools", "generate", "--check"]
      },
      "repair": {
        "repository": "tools",
        "argv": ["bin/tools", "generate"]
      }
    }
  ]
}
