{
  "schema_version": 1,
  "provider": "1password",
  "secrets": {
    "adguard.password": "op://<vault>/<adguard-item>/password",
    "adguard.username": "op://<vault>/<adguard-item>/username",
    "cloudflare.dns_token": "op://<vault>/<cloudflare-dns-item>/credential",
    "nginx.password": "op://<vault>/<proxy-manager-item>/password",
    "nginx.username": "op://<vault>/<proxy-manager-item>/username",
    "tailscale.oauth_client_id": "op://<vault>/<tailscale-acl-oauth-item>/username",
    "tailscale.oauth_client_secret": "op://<vault>/<tailscale-acl-oauth-item>/credential"
  }
}
