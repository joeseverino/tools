#compdef tools inbox vault marks backup dns-test cbm hq brand remember doc-to-pdf diagram repos brief start ship land resync backlog repo gate-preview
# Generated by `tools generate completions`; do not edit.

_tools_suite_contract() {
  local service="${service:-${words[1]}}"
  local -a commands
  local context state state_descr line
  typeset -A opt_args
  case "$service" in
    tools)
      commands=(
        'status:One-screen health check across vault, inbox, and backup'
        'doctor:Verify environment, deps, and installed symlinks'
        'check:Run the full CI suite locally: lint, tests, bench'
        'new:Scaffold a new tool in bin/ with the house conventions'
        'install:Create symlinks in $INSTALL_DIR for every tool'
        'describe:Emit the command surface of every tool as one JSON document (the emit-once contract)'
        'tui:Open the full-screen command-surface explorer (shorthand for '\''describe --tui'\'')'
        'generate:Regenerate contract-derived completions and README reference/inventory'
        'contracts:Inspect the producer → consumer contract graph and projection drift'
        'derive:Regenerate a declared consumer projection from its owner contract'
        'reinstall:Reinstall a registered uv tool from its checkout and verify it matches the source'
        'bump-engine:Re-lock severino-vault-engine in every consumer repo and reinstall their uv tools'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            status) _arguments '--json[Machine-readable output (one JSON object)]' ;;
            doctor) _arguments '--all[Cross-system rollup: also run hq doctor (exit 1 if any gate fails)]' '--live[Implies --all; also ask HQ for managed resources that have drifted from what it declares (hq drift, over SSH)]' '--json[Machine-readable output (one object, "checks" array)]' ;;
            check) _arguments '--no-bench[Skip the bench scripts (the slowest step)]' '--ci[Run hermetically, as CI does: this checkout'\''s bin first with the install dir off $PATH (no stale shadow), an empty global/system git config (no leaked defaultBranch, aliases, or hooks), and the bats version surfaced. ship --check uses this mode; set TOOLS_CI_BATS_VERSION to fail on a bats version other than CI'\''s.]' ;;
            new) _arguments '1:Name of the new tool (creates bin/<name>):' '--agent[Scaffold a lightweight agent-facing tool that emits the versioned result envelope]' '--verify[Generate derived surfaces and run the full non-benchmark check after scaffolding]' ;;
            describe) _arguments '1:Describe just one tool (delegates to <tool> --describe):' '2:With a tool, project its contract to one command — the token-minimal AI path (tools describe hq restart):' '--pretty[Indent the JSON for reading (default: compact, diff-stable)]' '--repos[Also fold in sibling repos'\'' emitters (severino-vault-mcp, life)]' '--tui[Browse the whole toolchain in a full-screen explorer (aggregate only; / filters, Enter copies an invocation). Shorthand: '\''tools tui'\'']' ;;
            tui) _arguments '--repos[Also fold in sibling repos'\'' emitters (severino-vault-mcp, life)]' ;;
            generate) _arguments '1:Generated surface (default: all):(all completions readme)' '--check[Fail when generated files are stale; do not write]' ;;
            contracts) _arguments '1:Contract or projection id to inspect (default: complete graph):' '--check[Run every declared projection check and fail when any derived artifact is stale]' '--json[Emit the graph, source fingerprints, and projection status as JSON]' '--scope[Maximum projection scope to inspect (default: fleet)]:scope:(local fleet live)' ;;
            derive) _arguments '1:Projection id from tools contracts (omit only with --all):' '--all[Plan every repairable projection in scope; required for a batch]' '--go[Execute the plan, then run each projection'\''s declared check]' '--json[Emit the plan or execution receipts as JSON]' '--scope[Maximum projection scope to derive (default: local)]:scope:(local fleet)' ;;
            reinstall) _arguments '1:Repository id from config/capabilities.json (default: every repo that declares an install):' ;;
            bump-engine) _arguments '--lock-only[Update the uv.lock files but skip the uv tool reinstalls]' ;;
          esac
          ;;
      esac
      ;;
    inbox)
      _arguments \
        '{-e,--edit}[Open the captured note in $EDITOR after writing. With no text/stdin, creates an empty note, opens the editor, then renames the file from its first non-empty content line on save.]' \
        '*:Note text (joined). Omitted when piping stdin.:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    vault)
      commands=(
        'sync:Pull and push the vault repo'
        'status:Working tree, inbox count, remote sync state, and whether doc metadata changed since the last hq sync'
        'inbox:List notes currently in the inbox'
        'daily:Populate the daily note'\''s generated brief region from brief --json (work to ship, review-due docs, stale backlog, drafts) as Obsidian callouts — idempotent; never touches your free-capture area below the region'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            daily) _arguments '--date[Daily note date (YYYY-MM-DD; default today)]:date:' ;;
          esac
          ;;
      esac
      ;;
    marks)
      commands=(
        'status:Counts in Safari vs archived in the vault, and the last sync'
        'list:One collection as it is in Safari right now'
        'sync:Regenerate the current notes and append new URLs to the Archive ledgers'
        'export:The canonical model (reading-list, bookmarks, favorites) as one JSON document'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            status) _arguments '--json[Machine-readable output]' ;;
            list) _arguments '1:Which Safari collection to list:(reading-list bookmarks favorites)' '--json[Machine-readable output]' ;;
            sync) _arguments '--dry-run[Report what would change without writing]' '--json[Machine-readable summary]' ;;
          esac
          ;;
      esac
      ;;
    backup)
      _arguments \
        '{-n,--dry-run}[Show what would be copied; do not write]' \
        '--no-commit[Skip the auto-commit step]' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    dns-test)
      _arguments \
        '-d[Domain to query (default: google.com)]:domain:' \
        '-n[Queries per path (default: 20)]:runs:' \
        '-a[AdGuard LAN resolver IP (required; env ADGUARD_IP)]:ip:' \
        '-b[Path label to use as delta baseline (default: "AdGuard LAN")]:label:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    cbm)
      commands=(
        'status:Whether the MCP handshake works, and every reason it might not'
        'fix:Kill wedged daemons, clear stale runtime state, verify the handshake'
        'prune:Delete old index-worker logs from the CBM cache'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            status) _arguments '--json[Machine-readable output]' '--no-probe[Skip the MCP handshake; report local state only]' '--timeout[Seconds to wait for the handshake (default 40)]:secs:' ;;
            fix) _arguments '--dry-run[Report what would be killed and removed without doing it]' ;;
            prune) _arguments '--days[Keep logs newer than N days (default 14)]:n:' ;;
          esac
          ;;
      esac
      ;;
    hq)
      commands=(
        'manifest:Print the manifest JSON (frontmatter from every doc) to stdout — for inspection or piping elsewhere'
        'sync:Sync the docs manifest into HQ; idempotent and safe to re-run'
        'dev:Run the composed stack locally: the host plus every private plugin checkout found, on one interpreter'
        'doctor:Report vault docs missing or with invalid frontmatter, and whether HQ'\''s last-synced manifest is stale'
        'schema:Regenerate HQ'\''s docs_index/schema.json from the installed MCP (the canonical frontmatter contract)'
        'validate:Report HQ registry entries (Projects/Assets) that no vault doc references. Read-only'
        'life-sync:Emit the Life vault projection on this Mac and install it on HQ (renewals, goals, tasks, claims, vehicles)'
        'create:Create or update a Project or Asset in HQ (idempotent upsert by slug)'
        'call:Call one HQ tool as the operator: the MCP tool contract, JSON arguments in, the tool'\''s JSON result out'
        'drift:List managed resources HQ reports out of sync or unhealthy; exit 1 when any are'
        'ship:Commit + push a small HQ change. The push IS the deploy: it triggers the gated pipeline (build → scan → deploy on green)'
        'env-diff:Key-level drift between the 1Password '\''severino-hq env'\'' item (the source of truth) and the env rendered on prod. Key names only — values never print'
        'env-apply:Apply 1Password env changes to prod now: runs severino-hq-secrets.service (renders + restarts only if something changed; the hourly timer does this anyway)'
        'logs:Show app container logs (default tail 50)'
        'restart:`docker compose restart app` — no rebuild, no migrations. For stuck state (env changes need env-push: restart does not re-read .env)'
        'open:Open $HQ_URL in the browser'
        'shell:ssh -t into the HQ Django shell (poke the ORM)'
        'superuser:ssh -t into HQ and run createsuperuser interactively'
        'export:Download the year summary to ./ and print the path'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            sync) _arguments '--prune[Delete orphan DocumentationRecord rows (doc_ids in HQ but not in the manifest), plus ContentItems linked only to them. Use after a doc_id rename or retirement]' '--no-update[Only create new records; never update existing ones]' ;;
            dev) _arguments '1:Bind address (default $HQ_DEV_BIND). Binds all interfaces because dev-hq.jseverino.com proxies to this Mac:' '--fresh[Delete the scratch database first, so the boot starts from empty and re-migrates]' ;;
            doctor) _arguments '--env[Instead: compare the settings that change what data MEANS (time zone, USE_TZ, reporting windows) between the resolved dev env and production. Exit 1 on a difference. Needs the 1Password CLI; prints these named non-secret settings only]' ;;
            schema) _arguments '--check[Verify the HQ schema.json and the vault schema doc match the MCP; exit 1 on drift without writing (CI / pre-deploy gate)]' ;;
            create) _arguments '1:What to create:(project asset)' '2:Registry slug (the create_project / create_asset key):' ;;
            call) _arguments '1:HQ tool name (list them: hq call describe_capabilities):' '2:Tool arguments as one JSON object (default: {}):' ;;
            drift) _arguments '--json[Print the drifted resources as JSON]' ;;
            ship) _arguments '{-m,--message}[Commit message for the HQ repo change (required)]:text:' ;;
            logs) _arguments '{-f,--follow}[Stream live output until Ctrl-C]' '--tail[Number of lines to show (default 50; ignored with --follow)]:n:' ;;
            export) _arguments '1:Year to export (default: current year):' '2:Output format (default: md):(md json)' ;;
          esac
          ;;
      esac
      ;;
    brand)
      commands=(
        'build:Rebuild every kit from brand/ + the social cards'
        'kit:Render a one-off kit into severino-brand/kits/<slug>'
        'figure:Render a brand-themed graphic (cover, banner, diagram) from a JSON spec'
        'status:Show brand location, engine version, and git state'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
          esac
          ;;
      esac
      ;;
    remember)
      _arguments \
        '{-d,--description}[Frontmatter description (default: title)]:str:' \
        '{-k,--hook}[MEMORY.md one-liner hook (default: title)]:str:' \
        '{-b,--body}[Body text in lieu of stdin]:str:' \
        '{-f,--body-file}[Body text from file]:file:' \
        '{-F,--force}[Overwrite an existing memory (update in place)]' \
        '--dir[Memory dir. Default: CLAUDE_MEMORY_DIR, else CLAUDE_PROJECT_DIR, else $PWD — encoded to ~/.claude/projects/<enc>/memory. No flag needed inside a Claude project.]:path:' \
        '--list[Show the MEMORY.md index]' \
        '--forget[Delete the memory and its index entry]:slug:' \
        '1:user | feedback | project | reference:' \
        '2:kebab- or snake-case identifier (becomes '\''name:'\'' in frontmatter; underscored in filename):' \
        '3:text shown as the link in MEMORY.md:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    doc-to-pdf)
      _arguments \
        '1:Markdown file to render.:' \
        '2:Output path (default: <input>.pdf beside the input).:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    diagram)
      _arguments \
        '*:Mermaid source file or directory:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    repos)
      commands=(
        'tui:Open the interactive repo dashboard and run ship/land/resync/shell actions'
      )
      _arguments -C \
        '--tui[Open the interactive repo fleet explorer (can execute ship/land/resync actions)]' \
        '--json[Machine-readable output (one JSON object, "repos" array)]' \
        '--dirty[Only repos with uncommitted changes]' \
        '--unpushed[Only repos with no remote, no upstream, or unpushed commits]' \
        '--prs[Fold each repo'\''s open-PR state (number, CI, review) into the output via gh (network; one gh call per repo with a remote)]' \
        '--fetch[git fetch --prune each repo before computing ahead/behind/gone, so the remote-tracking state is true now, not as of the last manual fetch (network; slower)]' \
        '--pm[Only repos whose package manager is PM (pnpm|npm|yarn|bun|none)]:pm:' \
        '--sizes[Include node_modules size (slower; runs du)]' \
        '--icloud[Count iCloud conflict duplicates ('\''name 2.ext'\'') per repo]' \
        '--root[Scan DIR instead of the defaults (repeatable)]:dir:' \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            tui) _arguments '1:Only repos whose name contains NAME:' '--dirty[Start on repos with uncommitted changes]' '--unpushed[Start on repos with no remote, no upstream, unpushed commits, or gone upstream]' '--fetch[git fetch --prune each repo on load so behind/gone state is current]' '--pm[Only repos whose package manager is PM (pnpm|npm|yarn|bun|none)]:pm:' '--sizes[Include node_modules size (slower; runs du)]' '--icloud[Count iCloud conflict duplicates ('\''name 2.ext'\'') per repo]' '--root[Scan DIR instead of the defaults (repeatable)]:dir:' ;;
          esac
          ;;
      esac
      ;;
    brief)
      commands=(
        'tui:Open the workspace cockpit — a ranked queue of what needs you, run ship/land/resync'
      )
      _arguments -C \
        '--json[Machine-readable digest (one JSON object)]' \
        '--prs[Include each repo'\''s open PR (number, CI, review) and surface green PRs to land (network — folds in '\''repos --prs'\'', the one PR owner)]' \
        '--days[Vault recent-changes window in days (default 7)]:days:' \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            tui) _arguments '--days[Vault recent-changes window in days (default 7)]:days:' ;;
          esac
          ;;
      esac
      ;;
    start)
      _arguments \
        '--from[Branch off origin/BASE instead of the repo'\''s default branch]:base:' \
        '1:Short name for the work; becomes the branch (kebab-cased). Omit for a timestamped name.:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    ship)
      _arguments \
        '--go[Actually commit/push/PR (default is a dry-run preview)]' \
        '--all[Required to act on more than one repo (a guard against accidental fleet ships)]' \
        '{-m,--message}[PR title + commit message (default: derived from changed paths)]:msg:' \
        '--body[PR body (default: a generated new/modified/removed file summary)]:body:' \
        '--no-pr[Commit and push only; do not open a PR]' \
        '--check[Run the repo'\''s own local gate (tools check --ci / scripts/check.sh / npm test) before pushing; skip the repo if it fails]' \
        '--watch[After opening/updating the PR, poll '\''gh pr checks'\'' until CI is green or red]' \
        '--rebranch[Recover a stale branch: replay its commits onto a fresh branch off origin/<base>, dropping any already merged (leaves the old branch untouched)]' \
        '1:Only repos whose name contains NAME:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    land)
      _arguments \
        '--go[Actually merge (default is a dry-run preview)]' \
        '--all[Required to land more than one repo (a guard against accidental fleet merges)]' \
        '--admin[Merge with gh pr merge --admin — bypass branch protection / required checks. For solo repos where you are the reviewer, or to land before CI is green.]' \
        '--merge[Use a merge commit instead of the default squash]' \
        '--rebase[Rebase-merge instead of the default squash]' \
        '1:Only repos whose name contains NAME:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    resync)
      _arguments \
        '{-n,--dry-run}[Show what would be reconciled; change nothing local]' \
        '--reap[Also delete local branches whose PR has merged but whose remote was not auto-deleted (one gh lookup per branch; never touches base, the current branch, or unmerged work)]' \
        '1:Only repos whose name contains NAME:' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
    backlog)
      commands=(
        'board:The default board, grouped by project'
        'list:Flat list view (same filters as the board)'
        'stale:Open/active tasks untouched past the stale window — the review nudge'
        'add:Capture a new task (delegates to the MCP'\''s add_task)'
        'move:Transition a task to a new status (stamps closed: on done)'
        'close:Shorthand for '\''move <id> done'\'''
      )
      _arguments -C \
        '--json[Machine-readable output (the MCP'\''s task-list JSON, "tasks" array)]' \
        '--status[Only tasks with status S (open|active|parked|done|wontfix)]:s:' \
        '--project[Only tasks owned by or touching project P]:p:' \
        '--stale[Only stale tasks (open/active, untouched > N days)]' \
        '--all[Include parked/done/wontfix (default shows only open + active)]' \
        '--days[Stale window in days (default 14)]:n:' \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            board) _arguments '--json[Machine-readable output]' '--status[Filter by status]:s:' '--project[Filter by project]:p:' '--stale[Only stale tasks]' '--all[Include parked/done/wontfix]' ;;
            list) _arguments '--json[Machine-readable output]' '--status[Filter by status]:s:' '--project[Filter by project]:p:' '--all[Include parked/done/wontfix]' ;;
            stale) _arguments '--days[Stale window in days (default 14)]:n:' '--json[Machine-readable output]' ;;
            add) _arguments '*:Imperative task title (joined):' '--project[Owning project — colocates at 01 Projects/<project>/tasks/]:p:' '--effort[Effort S|M|L (default S)]:e:' '--priority[Priority high|med|low (default med)]:p:' '--related-projects[Projects a cross-cutting task touches (space-separated)]:projects:' ;;
            move) _arguments '1:Task id or slug (task-foo or foo):' '2:Target status (open|active|parked|done|wontfix):' ;;
            close) _arguments '1:Task id or slug:' ;;
          esac
          ;;
      esac
      ;;
    repo)
      commands=(
        'new:Bootstrap a repo from the cordon-starter baseline, then register it'
        'register:Register an existing repo: vault project doc + HQ record + hq sync'
      )
      _arguments -C \
        '(-h --help)'{-h,--help}'[show help]' \
        '1:command:->command' '*::argument:->args'
      case "$state" in
        command) _describe 'command' commands ;;
        args)
          case "${words[2]}" in
            new) _arguments '1:kebab-case name — becomes the dir, the tool name, and the registry slug:' '--root[assets|projects — which Code root the repo lives under (default projects)]:r:' '--track[bash|node — the emitter track to keep (default bash)]:t:' '--name[Display name for the vault doc + HQ (default: slug, title-cased)]:name:' '--category[HQ project category (default automation)]:cat:' '--description[One-liner for the vault doc + HQ entry]:text:' '--public[Create the GitHub repo public (default private)]' '--local[Skip GitHub entirely — no gh create, no branch protection]' '--no-register[Skip the vault doc + HQ registration]' '{-n,--dry-run}[Print the plan; touch nothing]' ;;
            register) _arguments '1:The repo'\''s registry slug (its directory name):' '--path[Repo directory (default: $CODE_HOME/Assets/<slug> then $CODE_HOME/Projects/<slug>)]:dir:' '--name[Display name (default: slug, title-cased)]:name:' '--category[HQ project category (default automation)]:cat:' '--description[One-liner for the vault doc + HQ entry]:text:' '{-n,--dry-run}[Print the plan; touch nothing]' ;;
          esac
          ;;
      esac
      ;;
    gate-preview)
      _arguments \
        '--cordon[Cordon checkout whose engine to run (default: $CORDON_HOME, else the sibling Assets/cordon) — point it at a branch worktree to preview a proposed check change]:dir:' \
        '--json[Machine-readable output: one object with a per-repo verdicts array]' \
        '(-h --help)'{-h,--help}'[show help]'
      ;;
  esac
}

_tools_suite_contract "$@"
